@model Systeme_RH.Models.ViewModels.DepartementViewModel

@{
    ViewData["Title"] = "Modifier Département";
}

<style>
    :root {
        --warning: #f59e0b;
        --warning-dark: #d97706;
        --secondary: #64748b;
        --danger: #ef4444;
        --border: #e2e8f0;
        --bg-light: #f8fafc;
    }

    .form-card {
        max-width: 520px;
        margin: auto;
        background: #fff;
        border-radius: 14px;
        box-shadow: 0 8px 25px rgba(0,0,0,.08);
        border-top: 4px solid var(--warning);
        overflow: hidden;
    }

    .form-header {
        background: linear-gradient(135deg, #fffbeb, #fef3c7);
        padding: 1.5rem 2rem;
        border-bottom: 2px solid #fcd34d;
    }

    .form-header h4 {
        margin: 0;
        font-weight: 600;
        color: #92400e;
        display: flex;
        align-items: center;
        gap: .5rem;
    }

    .form-body {
        padding: 2rem;
    }

    .current-info {
        background: #ecfeff;
        border: 1px solid #67e8f9;
        border-radius: 10px;
        padding: 1rem;
        display: flex;
        gap: .75rem;
        margin-bottom: 1.5rem;
    }

    .current-info i {
        color: #0ea5e9;
        font-size: 1.3rem;
    }

    .form-label {
        font-weight: 600;
        margin-bottom: .4rem;
    }

    .form-control-custom {
        border-radius: 10px;
        border: 2px solid var(--border);
        padding: .75rem 1rem;
        transition: .2s ease;
    }

    .form-control-custom:focus {
        border-color: var(--warning);
        box-shadow: 0 0 0 4px rgba(245,158,11,.15);
    }

    .field-validation-error {
        color: var(--danger);
        font-size: .85rem;
        margin-top: .3rem;
        display: block;
    }

    .validation-summary {
        background: #fef2f2;
        border: 1px solid #fca5a5;
        border-radius: 10px;
        padding: 1rem;
        margin-bottom: 1.5rem;
        color: #991b1b;
    }

    /* ✅ BOUTONS CORRECTS */
    .form-actions {
        display: flex;
        gap: 1rem;
        margin-top: 1.5rem;
    }

    .btn-save {
        flex: 2;
        background: linear-gradient(135deg, var(--warning), var(--warning-dark));
        border: none;
        color: #fff;
        padding: .8rem;
        border-radius: 10px;
        font-weight: 600;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: .4rem;
    }

    .btn-save:hover {
        transform: translateY(-1px);
        box-shadow: 0 6px 18px rgba(245,158,11,.35);
    }

    .btn-cancel {
        flex: 1;
        background: #fff;
        border: 2px solid var(--border);
        color: var(--secondary);
        padding: .8rem;
        border-radius: 10px;
        font-weight: 600;
        text-align: center;
    }

    .btn-cancel:hover {
        background: var(--bg-light);
        color: #1e293b;
    }

    @@media (max-width: 576px) {
        .form-actions {
            flex-direction: column;
        }
    }
</style>

<div class="container">
    <div class="form-card">
        <div class="form-header">
            <h4><i class="bi bi-pencil-square"></i> Modifier Département</h4>
        </div>

        <div class="form-body">
            <form asp-action="Edit" method="post" novalidate>
                <input type="hidden" asp-for="Id" />

                <!-- Infos actuelles -->
                <div class="current-info">
                    <i class="bi bi-info-circle-fill"></i>
                    <div>
                        <strong>@Model.Nom</strong><br />
                        <small>ID #@Model.Id</small>
                    </div>
                </div>

                <!-- Erreurs -->
                <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

                <!-- Champ nom -->
                <div class="mb-4">
                    <label asp-for="Nom" class="form-label">
                        <i class="bi bi-building"></i> Nom du département
                    </label>

                    <input asp-for="Nom"
                           class="form-control form-control-custom"
                           placeholder="Ex : Ressources Humaines" />

                    <span asp-validation-for="Nom" class="field-validation-error"></span>
                </div>

                <!-- ✅ BOUTONS CORRIGÉS -->
                <div class="form-actions">
                    <button type="submit" class="btn-save">
                        <i class="bi bi-check-circle-fill"></i> Sauvegarder
                    </button>

                    <a asp-action="Index" class="btn-cancel">
                        <i class="bi bi-x-circle"></i> Annuler
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }

    <script>
        document.getElementById('Nom')?.focus();
    </script>
}
