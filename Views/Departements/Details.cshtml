@model Systeme_RH.Models.ViewModels.DepartementViewModel

@{
    ViewData["Title"] = "Détails Département";
    var employes = ViewBag.Employes as List<Systeme_RH.Models.ViewModels.EmployeViewModel>;
}

<style>
    :root {
        --primary-color: #2563eb;
        --primary-dark: #1e40af;
        --secondary-color: #64748b;
        --accent-color: #0ea5e9;
        --success-color: #10b981;
        --warning-color: #f59e0b;
        --danger-color: #ef4444;
        --light-bg: #f8fafc;
        --border-color: #e2e8f0;
        --text-dark: #1e293b;
        --text-muted: #64748b;
    }

    .header-card {
        background: linear-gradient(135deg, #2563eb 0%, #1e40af 100%);
        color: white;
        border-radius: 12px;
        padding: 2rem;
        box-shadow: 0 4px 15px rgba(37, 99, 235, 0.2);
        margin-bottom: 2rem;
        animation: fadeIn 0.5s ease;
    }

    .header-card h2 {
        font-size: 2rem;
        font-weight: 700;
        margin-bottom: 0.5rem;
    }

    .header-card .badge {
        background: rgba(255,255,255,0.2);
        padding: 0.4rem 1rem;
        border-radius: 20px;
        font-weight: 600;
        font-size: 0.9rem;
        margin-right: 0.5rem;
    }

    .section-card {
        background: white;
        border: none;
        border-radius: 12px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.08);
        margin-bottom: 2rem;
        overflow: hidden;
    }

    .section-header {
        background: linear-gradient(135deg, #f8fafc 0%, #e2e8f0 100%);
        padding: 1.5rem 2rem;
        border-bottom: 2px solid var(--border-color);
    }

    .section-header h5 {
        font-size: 1.3rem;
        font-weight: 600;
        color: var(--text-dark);
        margin: 0;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .section-header h5 i {
        color: var(--primary-color);
    }

    .btn-primary-custom {
        background: linear-gradient(135deg, var(--primary-color) 0%, var(--primary-dark) 100%);
        border: none;
        color: white;
        font-weight: 600;
        padding: 0.6rem 1.5rem;
        border-radius: 8px;
        transition: all 0.3s ease;
    }

    .btn-primary-custom:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 20px rgba(37, 99, 235, 0.3);
    }

    .table-custom {
        border-collapse: separate;
        border-spacing: 0;
        width: 100%;
    }

    .table-custom thead th {
        background-color: #f8fafc;
        color: var(--text-dark);
        font-weight: 600;
        text-transform: uppercase;
        font-size: 0.85rem;
        letter-spacing: 0.5px;
        padding: 1rem;
        border-bottom: 2px solid var(--border-color);
    }

    .table-custom tbody tr {
        transition: all 0.2s ease;
        border-bottom: 1px solid var(--border-color);
    }

    .table-custom tbody tr:hover {
        background-color: #f8fafc;
        transform: translateX(5px);
    }

    .table-custom tbody td {
        padding: 1rem;
        vertical-align: middle;
    }

    .badge-custom {
        padding: 0.4rem 0.8rem;
        border-radius: 6px;
        font-weight: 500;
        font-size: 0.85rem;
    }

    .badge-custom.secondary {
        background-color: #e2e8f0;
        color: #475569;
    }

    .badge-custom.success {
        background-color: #d1fae5;
        color: #065f46;
    }

    .badge-custom.danger {
        background-color: #fee2e2;
        color: #991b1b;
    }

    .btn-action {
        width: 36px;
        height: 36px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 8px;
        transition: all 0.2s ease;
    }

    .btn-action.info {
        background-color: #dbeafe;
        color: var(--primary-color);
    }

    .btn-action.info:hover {
        background-color: var(--primary-color);
        color: white;
        transform: scale(1.1);
    }

    .empty-state {
        padding: 4rem 2rem;
        text-align: center;
        color: var(--text-muted);
    }

    .empty-state i {
        font-size: 3rem;
        opacity: 0.5;
        margin-bottom: 1rem;
    }

    .empty-state p {
        font-size: 1.1rem;
        margin: 0;
    }

    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(-20px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>

<div class="container-fluid">
    <!-- En-tête du département -->
    <div class="header-card">
        <div class="row align-items-center">
            <div class="col-md-8">
                <h2>@Model.Nom</h2>
                <div class="d-flex flex-wrap gap-2 mt-3">
                    <span class="badge"><i class="bi bi-hash"></i> #@Model.Id</span>
                    <span class="badge"><i class="bi bi-people-fill"></i> @Model.NombreEmployes Employé(s)</span>
                    <span class="badge"><i class="bi bi-briefcase-fill"></i> @Model.NombrePostes Poste(s)</span>
                </div>
            </div>
            <div class="col-md-4 text-md-end mt-3 mt-md-0">
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary-custom me-2">
                    <i class="bi bi-pencil me-1"></i> Modifier
                </a>
                <a asp-action="Index" class="btn btn-light">
                    <i class="bi bi-arrow-left me-1"></i> Retour
                </a>
            </div>
        </div>
    </div>

    <!-- Section Équipe -->
    <div class="section-card">
        <div class="section-header">
            <h5><i class="bi bi-people-fill"></i> Équipe @Model.Nom</h5>
        </div>
        
        <div class="p-0">
            @if (employes != null && employes.Any())
            {
                <div class="table-responsive">
                    <table class="table-custom">
                        <thead>
                            <tr>
                                <th>Matricule</th>
                                <th>Nom & Prénom</th>
                                <th>Email</th>
                                <th>Poste</th>
                                <th>Statut</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var emp in employes)
                            {
                                <tr>
                                    <td class="fw-bold text-primary">@emp.Matricule</td>
                                    <td class="fw-bold">@emp.Nom @emp.Prenom</td>
                                    <td class="text-muted">@emp.Email</td>
                                    <td><span class="badge-custom secondary">@emp.PosteTitre</span></td>
                                    <td>
                                        @if(emp.EstActif) { 
                                            <span class="badge-custom success"><i class="bi bi-check-circle me-1"></i> Actif</span> 
                                        } 
                                        else { 
                                            <span class="badge-custom danger"><i class="bi bi-x-circle me-1"></i> Inactif</span> 
                                        }
                                    </td>
                                    <td class="text-end">
                                        <a asp-controller="Employes" asp-action="Details" asp-route-id="@emp.Id" class="btn-action info">
                                            <i class="bi bi-person-lines-fill"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="empty-state">
                    <i class="bi bi-person-x"></i>
                    <p class="mt-3">Aucun employé n'est affecté à ce département pour le moment.</p>
                </div>
            }
        </div>
    </div>
</div>