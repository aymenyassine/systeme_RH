@model IEnumerable<Systeme_RH.Models.ViewModels.DepartementViewModel>

@{
    ViewData["Title"] = "Départements";
}

<style>
    :root {
        --primary-color: #2563eb;
        --primary-dark: #1e40af;
        --secondary-color: #64748b;
        --accent-color: #0ea5e9;
        --success-color: #10b981;
        --warning-color: #f59e0b;
        --danger-color: #ef4444;
        --light-bg: #f8fafc;
        --border-color: #e2e8f0;
        --text-dark: #1e293b;
        --text-muted: #64748b;
    }

    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 2.5rem;
        padding-bottom: 1rem;
        border-bottom: 2px solid var(--border-color);
    }

    .page-header h1 {
        font-size: 1.8rem;
        font-weight: 700;
        color: var(--text-dark);
        margin: 0;
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }

    .page-header h1 i {
        color: var(--primary-color);
        font-size: 1.5rem;
    }

    .btn-primary-custom {
        background: linear-gradient(135deg, var(--primary-color) 0%, var(--primary-dark) 100%);
        border: none;
        color: white;
        font-weight: 600;
        padding: 0.8rem 1.5rem;
        border-radius: 8px;
        transition: all 0.3s ease;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
    }

    .btn-primary-custom:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 20px rgba(37, 99, 235, 0.3);
    }

    .department-card {
        background: white;
        border: none;
        border-radius: 12px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.06);
        transition: all 0.3s ease;
        overflow: hidden;
        height: 100%;
        position: relative;
        border-top: 4px solid;
        border-top-color: var(--primary-color);
    }

    .department-card:hover {
        transform: translateY(-8px);
        box-shadow: 0 12px 30px rgba(0,0,0,0.12);
    }

    .department-card .card-header {
        background: linear-gradient(135deg, #f8fafc 0%, #e2e8f0 100%);
        border-bottom: 1px solid var(--border-color);
        padding: 1.25rem 1.5rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .department-card .card-title {
        font-size: 1.1rem;
        font-weight: 700;
        color: var(--text-dark);
        margin: 0;
    }

    .department-card .dropdown-toggle {
        width: 32px;
        height: 32px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 6px;
        background: white;
        border: 1px solid var(--border-color);
        color: var(--text-muted);
        transition: all 0.2s ease;
    }

    .department-card .dropdown-toggle:hover {
        background: var(--light-bg);
        border-color: var(--primary-color);
        color: var(--primary-color);
    }

    .department-card .dropdown-menu {
        border: none;
        box-shadow: 0 10px 25px rgba(0,0,0,0.15);
        border-radius: 8px;
        padding: 0.5rem;
    }

    .dropdown-item {
        border-radius: 6px;
        padding: 0.6rem 1rem;
        transition: all 0.2s ease;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .dropdown-item:hover {
        background-color: var(--light-bg);
        color: var(--primary-color);
        transform: translateX(5px);
    }

    .dropdown-item.text-danger:hover {
        background-color: #fee2e2;
        color: #dc2626;
    }

    .department-card .card-body {
        padding: 1.5rem;
    }

    .stats-container {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1.5rem;
    }

    .stat-item {
        text-align: center;
        flex: 1;
    }

    .stat-value {
        font-size: 1.5rem;
        font-weight: 700;
        color: var(--text-dark);
        line-height: 1;
    }

    .stat-label {
        font-size: 0.85rem;
        color: var(--text-muted);
        margin-top: 0.25rem;
    }

    .stat-item i {
        font-size: 1.25rem;
        color: var(--primary-color);
        margin-bottom: 0.5rem;
    }

    .card-footer {
        background: white;
        border-top: 1px solid var(--border-color);
        padding: 1rem 1.5rem;
    }

    .btn-outline-primary-custom {
        border: 2px solid var(--primary-color);
        color: var(--primary-color);
        font-weight: 600;
        padding: 0.6rem 1.25rem;
        border-radius: 8px;
        transition: all 0.3s ease;
        width: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
    }

    .btn-outline-primary-custom:hover {
        background: var(--primary-color);
        color: white;
        transform: translateY(-2px);
        box-shadow: 0 8px 20px rgba(37, 99, 235, 0.2);
    }

    .empty-state {
        text-align: center;
        padding: 4rem 2rem;
        background: white;
        border-radius: 12px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.06);
        margin-top: 2rem;
    }

    .empty-state i {
        font-size: 3rem;
        color: var(--text-muted);
        opacity: 0.5;
        margin-bottom: 1rem;
    }

    .empty-state h4 {
        color: var(--text-dark);
        margin-bottom: 0.5rem;
        font-weight: 600;
    }

    .empty-state p {
        color: var(--text-muted);
        margin-bottom: 1.5rem;
    }

    .alert-custom {
        border-radius: 8px;
        border: none;
        box-shadow: 0 2px 8px rgba(0,0,0,0.06);
        margin-bottom: 1.5rem;
        padding: 1rem 1.5rem;
        display: flex;
        align-items: center;
    }

    .alert-custom.success {
        background: linear-gradient(135deg, #d1fae5 0%, #a7f3d0 100%);
        color: #065f46;
        border: 1px solid #a7f3d0;
    }

    .alert-custom.danger {
        background: linear-gradient(135deg, #fee2e2 0%, #fecaca 100%);
        color: #991b1b;
        border: 1px solid #fecaca;
    }

    .alert-custom i {
        font-size: 1.25rem;
        margin-right: 0.75rem;
    }
</style>

<div class="container-fluid">
    <!-- En-tête de la page -->
    <div class="page-header">
        <h1><i class="bi bi-building-fill"></i> Départements</h1>
        <a asp-action="Create" class="btn-primary-custom">
            <i class="bi bi-plus-lg"></i> Nouveau Département
        </a>
    </div>

    <!-- Messages d'alerte -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-custom success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill"></i> @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-custom danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill"></i> @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Grille des départements -->
    @if (Model != null && Model.Any())
    {
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
            @foreach (var item in Model)
            {
                <div class="col">
                    <div class="department-card">
                        <!-- En-tête de la carte avec menu déroulant -->
                        <div class="card-header">
                            <h5 class="card-title">@item.Nom</h5>
                            <div class="dropdown">
                                <button class="dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-three-dots-vertical"></i>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li>
                                        <a class="dropdown-item" asp-action="Edit" asp-route-id="@item.Id">
                                            <i class="bi bi-pencil"></i> Modifier
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-action="Details" asp-route-id="@item.Id">
                                            <i class="bi bi-eye"></i> Voir détails
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <a class="dropdown-item text-danger" asp-action="Delete" asp-route-id="@item.Id">
                                            <i class="bi bi-trash"></i> Supprimer
                                        </a>
                                    </li>
                                </ul>
                            </div>
                        </div>

                        <!-- Corps de la carte -->
                        <div class="card-body">
                            <div class="stats-container">
                                <div class="stat-item">
                                    <i class="bi bi-people-fill"></i>
                                    <div class="stat-value">@item.NombreEmployes</div>
                                    <div class="stat-label">Employés</div>
                                </div>
                                <div class="stat-item">
                                    <i class="bi bi-briefcase-fill"></i>
                                    <div class="stat-value">@item.NombrePostes</div>
                                    <div class="stat-label">Postes</div>
                                </div>
                            </div>
                            
                            <div class="d-flex align-items-center text-muted small">
                                <i class="bi bi-hash me-1"></i>
                                <span>ID: #@item.Id</span>
                            </div>
                        </div>

                        <!-- Pied de la carte -->
                        <div class="card-footer">
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn-outline-primary-custom">
                                <i class="bi bi-people"></i> Gérer l'équipe
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="empty-state">
            <i class="bi bi-building"></i>
            <h4 class="mt-3">Aucun département</h4>
            <p>Commencez par créer votre premier département.</p>
            <a asp-action="Create" class="btn-primary-custom">
                <i class="bi bi-plus-lg"></i> Créer un département
            </a>
        </div>
    }
</div>

<script>
    $(document).ready(function() {
        // Animation des cartes
        $('.department-card').hover(
            function() {
                $(this).css('transform', 'translateY(-8px)');
            },
            function() {
                $(this).css('transform', 'translateY(0)');
            }
        );

        // Animation des éléments de dropdown
        $('.dropdown-item').hover(
            function() {
                $(this).css('transform', 'translateX(5px)');
            },
            function() {
                $(this).css('transform', 'translateX(0)');
            }
        );
    });
</script>