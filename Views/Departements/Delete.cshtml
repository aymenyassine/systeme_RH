@model Systeme_RH.Models.ViewModels.DepartementViewModel

@{
    ViewData["Title"] = "Supprimer Département";
}

<style>
    :root {
        --primary-color: #2563eb;
        --primary-dark: #1e40af;
        --secondary-color: #64748b;
        --accent-color: #0ea5e9;
        --success-color: #10b981;
        --warning-color: #f59e0b;
        --danger-color: #ef4444;
        --light-bg: #f8fafc;
        --border-color: #e2e8f0;
        --text-dark: #1e293b;
        --text-muted: #64748b;
    }

    .confirmation-card {
        background: white;
        border: none;
        border-radius: 12px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.08);
        margin-bottom: 2rem;
        overflow: hidden;
        border-top: 4px solid var(--danger-color);
    }

    .confirmation-header {
        background: linear-gradient(135deg, #fee2e2 0%, #fecaca 100%);
        padding: 1.5rem 2rem;
        border-bottom: 2px solid #fca5a5;
    }

    .confirmation-header h4 {
        font-size: 1.3rem;
        font-weight: 600;
        color: #991b1b;
        margin: 0;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .confirmation-body {
        padding: 2rem;
    }

    .warning-card {
        background: linear-gradient(135deg, #fffbeb 0%, #fef3c7 100%);
        border: 1px solid #fcd34d;
        border-left: 4px solid #f59e0b;
        border-radius: 8px;
        padding: 1.5rem;
        margin-bottom: 2rem;
    }

    .warning-card h5 {
        color: #92400e;
        font-weight: 600;
        margin-bottom: 0.5rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .info-card {
        background: linear-gradient(135deg, #ecfeff 0%, #cffafe 100%);
        border: 1px solid #67e8f9;
        border-left: 4px solid var(--accent-color);
        border-radius: 8px;
        padding: 1.5rem;
        margin-bottom: 2rem;
    }

    .info-card h6 {
        color: #0e7490;
        font-weight: 600;
        margin-bottom: 0.5rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .detail-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 1rem 0;
        border-bottom: 1px solid var(--border-color);
    }

    .detail-label {
        color: var(--text-muted);
        font-weight: 500;
        flex: 1;
    }

    .detail-value {
        color: var(--text-dark);
        font-weight: 600;
        flex: 2;
        text-align: right;
    }

    .btn-danger-custom {
        background: linear-gradient(135deg, var(--danger-color) 0%, #dc2626 100%);
        border: none;
        color: white;
        font-weight: 600;
        padding: 0.8rem 2rem;
        border-radius: 8px;
        transition: all 0.3s ease;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
    }

    .btn-danger-custom:hover {
        background: linear-gradient(135deg, #dc2626 0%, #b91c1c 100%);
        transform: translateY(-2px);
        box-shadow: 0 8px 20px rgba(239, 68, 68, 0.3);
    }

    .btn-secondary-custom {
        background: white;
        border: 2px solid var(--border-color);
        color: var(--text-muted);
        font-weight: 600;
        padding: 0.8rem 2rem;
        border-radius: 8px;
        transition: all 0.3s ease;
    }

    .btn-secondary-custom:hover {
        background: var(--light-bg);
        border-color: var(--secondary-color);
        color: var(--text-dark);
        transform: translateY(-2px);
    }
</style>

<div class="container-fluid">
    <!-- Messages d'erreur -->
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-octagon-fill me-2"></i> @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Carte de confirmation -->
    <div class="confirmation-card">
        <div class="confirmation-header">
            <h4><i class="bi bi-exclamation-triangle-fill"></i> Confirmation de suppression</h4>
        </div>
        
        <div class="confirmation-body">
            <!-- Avertissement -->
            <div class="warning-card">
                <h5><i class="bi bi-shield-exclamation"></i> Action critique</h5>
                <p class="mb-0 text-dark">
                    Vous êtes sur le point de supprimer le département <strong class="text-danger">@Model.Nom</strong>.
                    Cette action est irréversible.
                </p>
            </div>

            <!-- Informations du département -->
            <div class="info-card">
                <h6><i class="bi bi-info-circle-fill"></i> Détails du département</h6>
                <div class="detail-row">
                    <span class="detail-label">Nom du département</span>
                    <span class="detail-value text-danger">@Model.Nom</span>
                </div>
                <div class="detail-row">
                    <span class="detail-label">Effectif actuel</span>
                    <span class="detail-value">
                        @if (Model.NombreEmployes > 0)
                        {
                            <span class="text-danger fw-bold">@Model.NombreEmployes employés</span>
                        }
                        else
                        {
                            <span class="text-success fw-bold">Aucun employé</span>
                        }
                    </span>
                </div>
                <div class="detail-row">
                    <span class="detail-label">Nombre de postes</span>
                    <span class="detail-value">
                        @if (Model.NombrePostes > 0)
                        {
                            <span class="text-danger fw-bold">@Model.NombrePostes postes</span>
                        }
                        else
                        {
                            <span class="text-success fw-bold">Aucun poste</span>
                        }
                    </span>
                </div>
            </div>

            <!-- Message d'information -->
            <div class="alert alert-light border mt-4">
                <i class="bi bi-lightbulb-fill text-warning me-2"></i>
                <span class="text-muted">
                    <strong>Note importante :</strong> 
                    La suppression n'est possible que si le département ne contient aucun employé ou poste.
                    Veuillez d'abord réaffecter les employés et postes associés avant de procéder à la suppression.
                </span>
            </div>

            <!-- Formulaire de suppression -->
            <form asp-action="Delete" class="mt-4">
                <input type="hidden" asp-for="Id" />
                <div class="d-flex justify-content-between">
                    <button type="submit" class="btn-danger-custom" @(Model.NombreEmployes > 0 ? "disabled" : "")>
                        <i class="bi bi-trash3-fill"></i> Confirmer la suppression
                    </button>
                    <a asp-action="Index" class="btn-secondary-custom">
                        <i class="bi bi-x-circle"></i> Annuler
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>