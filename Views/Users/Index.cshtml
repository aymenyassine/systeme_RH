@model IEnumerable<Systeme_RH.ViewModels.UserListViewModel>

@{
    ViewData["Title"] = "Gestion des Utilisateurs";
}

<style>
    .users-container {
        background: white;
        border-radius: 12px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.08);
        overflow: hidden;
    }

    .page-header {
        background: linear-gradient(135deg, #f8fafc 0%, #e2e8f0 100%);
        padding: 2rem;
        border-bottom: 1px solid #e2e8f0;
    }

    .page-title {
        color: #1e293b;
        font-weight: 700;
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }

    .btn-primary-custom {
        background: linear-gradient(135deg, #2563eb 0%, #1e40af 100%);
        border: none;
        color: white;
        font-weight: 600;
        padding: 0.75rem 1.5rem;
        border-radius: 8px;
        transition: all 0.2s ease;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
    }

    .btn-primary-custom:hover {
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(37, 99, 235, 0.3);
    }

    .users-table {
        margin: 0;
    }

    .table-header {
        background: #f1f5f9;
        color: #475569;
        font-weight: 600;
        text-transform: uppercase;
        font-size: 0.85rem;
        letter-spacing: 0.5px;
    }

    .table-header th {
        border-bottom: 2px solid #e2e8f0;
        padding: 1rem 1.5rem;
    }

    .table-body td {
        padding: 1rem 1.5rem;
        vertical-align: middle;
        border-bottom: 1px solid #f1f5f9;
        transition: all 0.2s ease;
    }

    .table-body tr:hover td {
        background-color: #f8fafc;
    }

    .badge-admin {
        background: linear-gradient(135deg, #dc2626 0%, #b91c1c 100%);
        color: white;
        padding: 0.35rem 0.75rem;
        border-radius: 20px;
        font-size: 0.75rem;
        font-weight: 600;
    }

    .badge-rh {
        background: linear-gradient(135deg, #0ea5e9 0%, #0284c7 100%);
        color: white;
        padding: 0.35rem 0.75rem;
        border-radius: 20px;
        font-size: 0.75rem;
        font-weight: 600;
    }

    .badge-employee {
        background: linear-gradient(135deg, #64748b 0%, #475569 100%);
        color: white;
        padding: 0.35rem 0.75rem;
        border-radius: 20px;
        font-size: 0.75rem;
        font-weight: 600;
    }

    .badge-active {
        background: linear-gradient(135deg, #10b981 0%, #059669 100%);
        color: white;
        padding: 0.35rem 0.75rem;
        border-radius: 20px;
        font-size: 0.75rem;
        font-weight: 600;
    }

    .badge-inactive {
        background: linear-gradient(135deg, #94a3b8 0%, #64748b 100%);
        color: white;
        padding: 0.35rem 0.75rem;
        border-radius: 20px;
        font-size: 0.75rem;
        font-weight: 600;
    }

    .action-buttons {
        display: flex;
        gap: 0.5rem;
        justify-content: flex-end;
    }

    .btn-action {
        width: 36px;
        height: 36px;
        border-radius: 8px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        transition: all 0.2s ease;
        border: none;
    }

    .btn-edit {
        background: #dbeafe;
        color: #2563eb;
    }

    .btn-edit:hover {
        background: #2563eb;
        color: white;
        transform: translateY(-2px);
    }

    .btn-view {
        background: #e0f2fe;
        color: #0ea5e9;
    }

    .btn-view:hover {
        background: #0ea5e9;
        color: white;
        transform: translateY(-2px);
    }

    .btn-reset {
        background: #fef3c7;
        color: #d97706;
    }

    .btn-reset:hover {
        background: #d97706;
        color: white;
        transform: translateY(-2px);
    }

    .btn-delete {
        background: #fee2e2;
        color: #dc2626;
    }

    .btn-delete:hover {
        background: #dc2626;
        color: white;
        transform: translateY(-2px);
    }

    .no-users {
        text-align: center;
        padding: 3rem;
        color: #64748b;
    }

    .user-avatar {
        width: 36px;
        height: 36px;
        border-radius: 50%;
        background: linear-gradient(135deg, #2563eb 0%, #1e40af 100%);
        color: white;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-weight: 600;
        margin-right: 0.75rem;
    }
</style>

<div class="container-fluid py-4">
    <div class="users-container">
        <div class="page-header">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h1 class="page-title">
                        <i class="bi bi-people-fill"></i> Gestion des Utilisateurs
                    </h1>
                    <p class="text-muted mb-0">Administrez les comptes utilisateurs et leurs permissions</p>
                </div>
                <a asp-action="Create" class="btn btn-primary-custom">
                    <i class="bi bi-person-plus"></i> Nouvel Utilisateur
                </a>
            </div>
        </div>

        <div class="table-responsive">
            <table class="table users-table">
                <thead class="table-header">
                    <tr>
                        <th>Utilisateur</th>
                        <th>Email / Login</th>
                        <th>Rôle</th>
                        <th>Statut</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody class="table-body">
                    @if (Model.Any())
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center">
                                        <div>
                                            <div class="fw-bold">@item.NomComplet</div>
                                            <small class="text-muted">ID: @item.Id!.Substring(0, 8)...</small>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <div class="fw-medium">@item.Email</div>
                                    <small class="text-muted">Identifiant de connexion</small>
                                </td>
                                <td>
                                    @if (item.Role == "Admin")
                                    {
                                        <span class="badge-admin">
                                            <i class="bi bi-shield-lock"></i> Admin
                                        </span>
                                    }
                                    else if (item.Role == "RH")
                                    {
                                        <span class="badge-rh">
                                            <i class="bi bi-briefcase"></i> RH
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge-employee">
                                            <i class="bi bi-person"></i> Employé
                                        </span>
                                    }
                                </td>
                                <td>
                                    @if (item.EstActif)
                                    {
                                        <span class="badge-active">
                                            <i class="bi bi-check-circle"></i> Actif
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge-inactive">
                                            <i class="bi bi-slash-circle"></i> Inactif
                                        </span>
                                    }
                                </td>
                                <td>
                                    <div class="action-buttons">
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn-action btn-edit" title="Modifier">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <a asp-action="Details" asp-route-id="@item.Id" class="btn-action btn-view" title="Détails">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a asp-action="ResetPassword" asp-route-id="@item.Id" class="btn-action btn-reset" title="Réinitialiser MDP">
                                            <i class="bi bi-key"></i>
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn-action btn-delete" title="Supprimer">
                                            <i class="bi bi-trash"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="no-users">
                                <div class="py-5">
                                    <i class="bi bi-people display-1 text-muted"></i>
                                    <h4 class="mt-3">Aucun utilisateur trouvé</h4>
                                    <p class="text-muted">Commencez par créer votre premier utilisateur</p>
                                    <a asp-action="Create" class="btn btn-primary-custom mt-2">
                                        <i class="bi bi-person-plus"></i> Créer un utilisateur
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            // Animation d'entrée des lignes
            $('.table-body tr').each(function(index) {
                $(this).css('opacity', '0');
                setTimeout(() => {
                    $(this).animate({ opacity: 1 }, 300);
                }, index * 100);
            });

            // Confirmation avant suppression
            $('.btn-delete').on('click', function(e) {
                if (!confirm('Êtes-vous sûr de vouloir supprimer cet utilisateur ? Cette action est irréversible.')) {
                    e.preventDefault();
                }
            });
        });
    </script>
}