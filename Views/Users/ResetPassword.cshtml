@model Systeme_RH.ViewModels.AdminResetPasswordViewModel

@{
    ViewData["Title"] = "Réinitialiser Mot de Passe";
}

<style>
    .reset-card {
        background: white;
        border: none;
        border-radius: 12px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.08);
        overflow: hidden;
    }

    .card-header-warning {
        background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
        color: white;
        padding: 1.5rem;
        border-bottom: none;
    }

    .card-header-warning h5 {
        font-weight: 600;
        margin: 0;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .info-alert {
        background: linear-gradient(135deg, #e0f2fe 0%, #bae6fd 100%);
        border: 1px solid #7dd3fc;
        border-radius: 8px;
        padding: 1rem;
        margin-bottom: 1.5rem;
    }

    .password-strength {
        font-size: 0.85rem;
        padding: 0.5rem;
        border-radius: 6px;
        margin-top: 0.5rem;
        display: none;
    }

    .strength-weak { background-color: #fee2e2; color: #dc2626; }
    .strength-medium { background-color: #fef3c7; color: #d97706; }
    .strength-strong { background-color: #dcfce7; color: #16a34a; }

    .btn-warning-custom {
        background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
        border: none;
        color: white;
        font-weight: 600;
        padding: 0.75rem 1.5rem;
        border-radius: 8px;
        transition: all 0.2s ease;
    }

    .btn-warning-custom:hover {
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(245, 158, 11, 0.3);
    }
</style>

<div class="container-fluid py-4">
    <div class="row justify-content-center">
        <div class="col-lg-6 col-xl-5">
            <div class="reset-card">
                <div class="card-header-warning">
                    <h5><i class="bi bi-key-fill"></i> Réinitialisation du mot de passe</h5>
                </div>
                
                <div class="card-body p-4">
                    <div class="info-alert">
                        <div class="d-flex align-items-center">
                            <i class="bi bi-info-circle-fill text-primary me-2"></i>
                            <div>
                                <strong>Action administrative</strong>
                                <p class="mb-0 small">Vous définissez un nouveau mot de passe pour cet utilisateur. L'ancien mot de passe sera écrasé.</p>
                            </div>
                        </div>
                    </div>

                    <form asp-action="ResetPassword" id="resetForm">
                        <input type="hidden" asp-for="Id" />
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4">
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>

                        <div class="mb-4">
                            <label asp-for="NewPassword" class="form-label fw-bold">
                                <i class="bi bi-lock"></i> Nouveau mot de passe *
                            </label>
                            <input asp-for="NewPassword" class="form-control" 
                                   type="password" 
                                   placeholder="Minimum 8 caractères" 
                                   id="newPassword" />
                            <div class="password-strength" id="passwordStrength"></div>
                            <span asp-validation-for="NewPassword" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="ConfirmPassword" class="form-label fw-bold">
                                <i class="bi bi-lock-fill"></i> Confirmer le mot de passe *
                            </label>
                            <input asp-for="ConfirmPassword" class="form-control" 
                                   type="password" 
                                   placeholder="Resaisissez le mot de passe" />
                            <div id="passwordMatch" class="small mt-1"></div>
                            <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                        </div>

                        <div class="d-flex justify-content-between align-items-center pt-4 border-top">
                            <a asp-action="Index" class="btn btn-outline-secondary-custom">
                                <i class="bi bi-x-lg"></i> Annuler
                            </a>
                            
                            <button type="submit" class="btn btn-warning-custom" id="submitBtn">
                                <i class="bi bi-key"></i> Réinitialiser le mot de passe
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    
    <script>
        $(document).ready(function() {
            const newPassword = $('#newPassword');
            const confirmPassword = $('#ConfirmPassword');
            const passwordStrength = $('#passwordStrength');
            const passwordMatch = $('#passwordMatch');
            const submitBtn = $('#submitBtn');

            function checkPasswordStrength(password) {
                let strength = 0;
                if (password.length >= 8) strength++;
                if (/[A-Z]/.test(password)) strength++;
                if (/[0-9]/.test(password)) strength++;
                if (/[^A-Za-z0-9]/.test(password)) strength++;

                return strength;
            }

            newPassword.on('input', function() {
                const password = $(this).val();
                const strength = checkPasswordStrength(password);
                
                passwordStrength.css('display', 'block');
                
                if (password.length === 0) {
                    passwordStrength.css('display', 'none');
                } else if (strength < 2) {
                    passwordStrength.removeClass().addClass('password-strength strength-weak')
                        .html('<i class="bi bi-exclamation-triangle"></i> Mot de passe faible');
                } else if (strength < 4) {
                    passwordStrength.removeClass().addClass('password-strength strength-medium')
                        .html('<i class="bi bi-check-circle"></i> Mot de passe moyen');
                } else {
                    passwordStrength.removeClass().addClass('password-strength strength-strong')
                        .html('<i class="bi bi-shield-check"></i> Mot de passe fort');
                }

                checkPasswordsMatch();
            });

            confirmPassword.on('input', checkPasswordsMatch);

            function checkPasswordsMatch() {
                const password = newPassword.val();
                const confirm = confirmPassword.val();
                
                if (confirm.length === 0) {
                    passwordMatch.html('');
                    return;
                }
                
                if (password === confirm) {
                    passwordMatch.html('<i class="bi bi-check-circle-fill text-success"></i> Les mots de passe correspondent');
                    passwordMatch.removeClass('text-danger').addClass('text-success');
                } else {
                    passwordMatch.html('<i class="bi bi-exclamation-circle-fill text-danger"></i> Les mots de passe ne correspondent pas');
                    passwordMatch.removeClass('text-success').addClass('text-danger');
                }
            }
        });
    </script>
}