@model Systeme_RH.Models.ViewModels.EmployeViewModel

@{
    ViewData["Title"] = "Nouvel Employé";
}

<style>
    .create-card {
        background: white;
        border: none;
        border-radius: 12px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.08);
        overflow: hidden;
    }

    .card-header-primary {
        background: linear-gradient(135deg, #2563eb 0%, #1e40af 100%);
        color: white;
        padding: 1.5rem;
        border-bottom: none;
    }

    .card-header-primary h4 {
        font-weight: 600;
        margin: 0;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .user-link-card {
        background: linear-gradient(135deg, #e0f2fe 0%, #bae6fd 100%);
        border: 2px solid #0ea5e9;
        border-radius: 10px;
        padding: 1.5rem;
        margin: 1.5rem 0;
    }

    .section-title {
        color: #1e293b;
        font-weight: 600;
        margin-bottom: 1.5rem;
        padding-bottom: 0.5rem;
        border-bottom: 2px solid #e2e8f0;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .form-label-custom {
        font-weight: 600;
        color: #1e293b;
        margin-bottom: 0.5rem;
        display: flex;
        align-items: center;
        gap: 0.3rem;
    }

    .form-control-custom {
        border: 1px solid #e2e8f0;
        border-radius: 8px;
        padding: 0.75rem;
        transition: all 0.2s ease;
    }

    .form-control-custom:focus {
        border-color: #2563eb;
        box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.1);
    }

    .input-group-custom .input-group-text {
        background: #f1f5f9;
        border: 1px solid #e2e8f0;
        color: #64748b;
    }

    .info-tip {
        background: #f8fafc;
        border-radius: 8px;
        padding: 1rem;
        margin-top: 0.5rem;
        border-left: 4px solid #0ea5e9;
    }

    .btn-success-custom {
        background: linear-gradient(135deg, #10b981 0%, #059669 100%);
        border: none;
        color: white;
        font-weight: 600;
        padding: 0.75rem 1.5rem;
        border-radius: 8px;
        transition: all 0.2s ease;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
    }

    .btn-success-custom:hover {
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(16, 185, 129, 0.3);
    }

    .auto-fill-indicator {
        font-size: 0.85rem;
        color: #10b981;
        display: flex;
        align-items: center;
        gap: 0.3rem;
        margin-top: 0.25rem;
        opacity: 0;
        transition: opacity 0.3s ease;
    }

    .field-filled {
        border-color: #10b981 !important;
        background-color: #f0fdf4 !important;
    }
</style>

<div class="container-fluid py-4">
    <div class="row justify-content-center">
        <div class="col-lg-10 col-xl-9">
            <div class="create-card">
                <div class="card-header-primary">
                    <h4><i class="bi bi-person-plus-fill"></i> Créer un nouvel employé</h4>
                </div>
                
                <div class="card-body p-4">
                    <form asp-action="Create" id="createEmployeForm">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4">
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>

                        <!-- Section Lien Utilisateur -->
                        <div class="user-link-card">
                            <h5 class="section-title mb-3">
                                <i class="bi bi-laptop"></i> Accès Application RH
                            </h5>
                            
                            <div class="mb-3">
                                <label class="form-label-custom">
                                    <i class="bi bi-link-45deg"></i> Lier à un compte utilisateur existant ?
                                </label>
                                <select asp-for="ApplicationUserId" 
                                        id="userSelect" 
                                        class="form-control-custom border-info" 
                                        asp-items="ViewBag.UnlinkedUsers">
                                    <option value="">-- NON (Créer un nouveau compte automatiquement) --</option>
                                </select>
                            </div>
                            
                            <div class="info-tip">
                                <div class="d-flex align-items-start">
                                    <i class="bi bi-lightbulb-fill text-warning fs-5 me-2"></i>
                                    <div>
                                        <strong class="text-dark">Astuce :</strong>
                                        <p class="mb-0 small">
                                            Si vous sélectionnez un utilisateur existant, ses informations (Nom, Prénom, Email, Téléphone) 
                                            seront automatiquement remplies !
                                        </p>
                                    </div>
                                </div>
                            </div>
                            
                            <div class="mt-3 small text-muted">
                                <i class="bi bi-info-circle-fill text-info"></i> 
                                Si vous laissez ce champ vide, un compte sera créé avec :
                                <ul class="mb-0 mt-1">
                                    <li><strong>Login :</strong> [Email]</li>
                                    <li><strong>Mot de passe :</strong> Pass[Matricule]!</li>
                                </ul>
                            </div>
                        </div>

                        <!-- Section Identité & Contact -->
                        <h5 class="section-title mt-5">
                            <i class="bi bi-person-badge"></i> Identité & Contact
                        </h5>
                        
                        <div class="row g-4 mb-4">
                            <div class="col-md-4">
                                <label asp-for="Matricule" class="form-label-custom">
                                    <i class="bi bi-hash"></i> Matricule *
                                </label>
                                <input asp-for="Matricule" class="form-control-custom" placeholder="Ex: EMP-2025-01" />
                                <span asp-validation-for="Matricule" class="text-danger small"></span>
                            </div>
                            
                            <div class="col-md-4">
                                <label asp-for="Nom" class="form-label-custom">
                                    <i class="bi bi-person"></i> Nom *
                                </label>
                                <input asp-for="Nom" id="nomInput" class="form-control-custom" />
                                <span id="nomAutoFill" class="auto-fill-indicator">
                                    <i class="bi bi-check-circle"></i> Rempli automatiquement
                                </span>
                                <span asp-validation-for="Nom" class="text-danger small"></span>
                            </div>
                            
                            <div class="col-md-4">
                                <label asp-for="Prenom" class="form-label-custom">
                                    <i class="bi bi-person"></i> Prénom *
                                </label>
                                <input asp-for="Prenom" id="prenomInput" class="form-control-custom" />
                                <span id="prenomAutoFill" class="auto-fill-indicator">
                                    <i class="bi bi-check-circle"></i> Rempli automatiquement
                                </span>
                                <span asp-validation-for="Prenom" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="row g-4 mb-4">
                            <div class="col-md-6">
                                <label asp-for="Email" class="form-label-custom">
                                    <i class="bi bi-envelope"></i> Email Professionnel *
                                </label>
                                <div class="input-group input-group-custom">
                                    <span class="input-group-text">
                                        <i class="bi bi-at"></i>
                                    </span>
                                    <input asp-for="Email" id="emailInput" type="email" class="form-control-custom" 
                                           placeholder="nom.prenom@entreprise.com" />
                                </div>
                                <span id="emailAutoFill" class="auto-fill-indicator">
                                    <i class="bi bi-check-circle"></i> Rempli automatiquement
                                </span>
                                <span asp-validation-for="Email" class="text-danger small"></span>
                            </div>
                            
                            <div class="col-md-6">
                                <label asp-for="Telephone" class="form-label-custom">
                                    <i class="bi bi-telephone"></i> Téléphone
                                </label>
                                <div class="input-group input-group-custom">
                                    <span class="input-group-text">
                                        <i class="bi bi-phone"></i>
                                    </span>
                                    <input asp-for="Telephone" id="telephoneInput" class="form-control-custom" 
                                           placeholder="06 XX XX XX XX" />
                                </div>
                                <span id="telephoneAutoFill" class="auto-fill-indicator">
                                    <i class="bi bi-check-circle"></i> Rempli automatiquement
                                </span>
                                <span asp-validation-for="Telephone" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="row g-4 mb-5">
                            <div class="col-md-6">
                                <label asp-for="DateNaissance" class="form-label-custom">
                                    <i class="bi bi-calendar"></i> Date de Naissance
                                </label>
                                <input asp-for="DateNaissance" type="date" class="form-control-custom" />
                                <span asp-validation-for="DateNaissance" class="text-danger small"></span>
                            </div>
                            
                            <div class="col-md-6">
                                <label asp-for="Adresse" class="form-label-custom">
                                    <i class="bi bi-geo-alt"></i> Adresse
                                </label>
                                <textarea asp-for="Adresse" class="form-control-custom" rows="1" 
                                          placeholder="Adresse complète..."></textarea>
                                <span asp-validation-for="Adresse" class="text-danger small"></span>
                            </div>
                        </div>

                        <!-- Section Poste & Contrat -->
                        <h5 class="section-title">
                            <i class="bi bi-briefcase"></i> Poste & Contrat
                        </h5>

                        <div class="row g-4 mb-4">
                            <div class="col-md-6">
                                <label asp-for="DepartementId" class="form-label-custom">
                                    <i class="bi bi-building"></i> Département *
                                </label>
                                <select asp-for="DepartementId" class="form-control-custom" asp-items="ViewBag.DepartementId">
                                    <option value="">-- Sélectionner un département --</option>
                                </select>
                                <span asp-validation-for="DepartementId" class="text-danger small"></span>
                            </div>
                            
                            <div class="col-md-6">
                                <label asp-for="PosteId" class="form-label-custom">
                                    <i class="bi bi-briefcase"></i> Poste *
                                </label>
                                <select asp-for="PosteId" class="form-control-custom" asp-items="ViewBag.PosteId">
                                    <option value="">-- Sélectionner un poste --</option>
                                </select>
                                <span asp-validation-for="PosteId" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="row g-4 mb-5">
                            <div class="col-md-4">
                                <label asp-for="DateEmbauche" class="form-label-custom">
                                    <i class="bi bi-calendar-check"></i> Date d'Embauche *
                                </label>
                                <input asp-for="DateEmbauche" type="date" class="form-control-custom" />
                                <span asp-validation-for="DateEmbauche" class="text-danger small"></span>
                            </div>
                            
                            <div class="col-md-4">
                                <label asp-for="Salaire" class="form-label-custom">
                                    <i class="bi bi-cash-stack"></i> Salaire *
                                </label>
                                <div class="input-group input-group-custom">
                                    <input asp-for="Salaire" type="number" step="0.01" class="form-control-custom text-end" 
                                           placeholder="0.00" />
                                    <span class="input-group-text">DH</span>
                                </div>
                                <small class="text-muted">Salaire mensuel brut</small>
                                <span asp-validation-for="Salaire" class="text-danger small"></span>
                            </div>
                            
                            <div class="col-md-4">
                                <label asp-for="SoldeConges" class="form-label-custom">
                                    <i class="bi bi-calendar-plus"></i> Solde Congés *
                                </label>
                                <div class="input-group input-group-custom">
                                    <input asp-for="SoldeConges" type="number" step="0.5" class="form-control-custom text-end" 
                                           value="0" />
                                    <span class="input-group-text">Jours</span>
                                </div>
                                <small class="text-muted">Solde initial de congés</small>
                                <span asp-validation-for="SoldeConges" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="d-flex justify-content-between align-items-center pt-4 border-top">
                            <a asp-action="Index" class="btn btn-outline-secondary-custom">
                                <i class="bi bi-arrow-left"></i> Retour
                            </a>
                            
                            <button type="submit" class="btn btn-success-custom">
                                <i class="bi bi-check-lg"></i> Créer l'employé
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    
    <script>
        $(document).ready(function() {
            const userSelect = $('#userSelect');
            const nomInput = $('#nomInput');
            const prenomInput = $('#prenomInput');
            const emailInput = $('#emailInput');
            const telephoneInput = $('#telephoneInput');
            
            const autoFillIndicators = {
                nom: $('#nomAutoFill'),
                prenom: $('#prenomAutoFill'),
                email: $('#emailAutoFill'),
                telephone: $('#telephoneAutoFill')
            };

            userSelect.on('change', function() {
                const userId = $(this).val();
                
                // Réinitialiser les indicateurs
                Object.values(autoFillIndicators).forEach(indicator => {
                    indicator.css('opacity', '0');
                });
                
                // Réinitialiser les styles des champs
                [nomInput, prenomInput, emailInput, telephoneInput].forEach(field => {
                    field.removeClass('field-filled');
                });
                
                if (!userId) return;

                // Récupérer les infos de l'utilisateur
                fetch(`/Employes/GetUserInfo?userId=${userId}`)
                    .then(response => {
                        if (!response.ok) throw new Error('Erreur réseau');
                        return response.json();
                    })
                    .then(data => {
                        // Mettre à jour les champs
                        nomInput.val(data.nom || '');
                        prenomInput.val(data.prenom || '');
                        emailInput.val(data.email || '');
                        telephoneInput.val(data.phoneNumber || '');

                        // Animer les champs remplis
                        const fields = [
                            { input: nomInput, indicator: autoFillIndicators.nom, value: data.nom },
                            { input: prenomInput, indicator: autoFillIndicators.prenom, value: data.prenom },
                            { input: emailInput, indicator: autoFillIndicators.email, value: data.email },
                            { input: telephoneInput, indicator: autoFillIndicators.telephone, value: data.phoneNumber }
                        ];

                        fields.forEach(({ input, indicator, value }) => {
                            if (value) {
                                input.addClass('field-filled');
                                indicator.css('opacity', '1');
                                
                                // Animation de pulse
                                input.animate({
                                    backgroundColor: '#f0fdf4'
                                }, 500, function() {
                                    $(this).animate({
                                        backgroundColor: '#ffffff'
                                    }, 500);
                                });
                            }
                        });
                    })
                    .catch(error => {
                        console.error('Erreur:', error);
                        showToast('Impossible de récupérer les informations de l\'utilisateur', 'error');
                    });
            });

            // Générer un email suggéré
            nomInput.add(prenomInput).on('input', function() {
                const nom = nomInput.val().trim().toLowerCase();
                const prenom = prenomInput.val().trim().toLowerCase();
                
                if (nom && prenom) {
                    const suggestedEmail = `${prenom}.${nom}@@entreprise.com`;
                    if (!emailInput.val()) {
                        emailInput.val(suggestedEmail);
                    }
                }
            });
        });
    </script>
}