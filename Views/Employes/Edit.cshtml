@model Systeme_RH.Models.ViewModels.EmployeViewModel

@{
    ViewData["Title"] = "Modifier Employé";
}

<style>
    .edit-card {
        background: white;
        border: none;
        border-radius: 12px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.08);
        overflow: hidden;
    }

    .card-header-warning {
        background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
        color: white;
        padding: 1.5rem;
        border-bottom: none;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .card-header-warning h4 {
        font-weight: 600;
        margin: 0;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .employee-header {
        display: flex;
        align-items: center;
        gap: 1rem;
        margin-bottom: 2rem;
    }

    .employee-avatar {
        width: 80px;
        height: 80px;
        border-radius: 50%;
        background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 2rem;
        font-weight: 700;
    }

    .section-divider {
        color: #1e293b;
        font-weight: 600;
        margin: 2rem 0 1.5rem;
        padding-bottom: 0.5rem;
        border-bottom: 2px solid #e2e8f0;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .status-switch {
        background: #f1f5f9;
        border-radius: 8px;
        padding: 1rem;
        margin: 1rem 0;
    }

    .form-check-input:checked {
        background-color: #10b981;
        border-color: #10b981;
    }

    .form-check-input:focus {
        box-shadow: 0 0 0 3px rgba(16, 185, 129, 0.1);
    }

    .btn-warning-custom {
        background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
        border: none;
        color: white;
        font-weight: 600;
        padding: 0.75rem 1.5rem;
        border-radius: 8px;
        transition: all 0.2s ease;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
    }

    .btn-warning-custom:hover {
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(245, 158, 11, 0.3);
    }
</style>

<div class="container-fluid py-4">
    <div class="edit-card">
        <div class="card-header-warning">
            <h4><i class="bi bi-pencil-square"></i> Modifier l'employé</h4>
        </div>
        
        <div class="card-body p-4">
            <div class="employee-header">
                <div class="employee-avatar">
                    @Model.Nom[0]@Model.Prenom[0]
                </div>
                <div>
                    <h3 class="mb-1">@Model.Nom @Model.Prenom</h3>
                    <p class="text-muted mb-0">Matricule : @Model.Matricule</p>
                </div>
            </div>

            <form asp-action="Edit" id="editForm">
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="ApplicationUserId" />
                
                <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4">
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>

                <h5 class="section-divider">
                    <i class="bi bi-person-badge"></i> Informations Personnelles
                </h5>

                <div class="row g-4 mb-4">
                    <div class="col-md-6">
                        <label asp-for="Matricule" class="form-label-custom">
                            <i class="bi bi-hash"></i> Matricule *
                        </label>
                        <input asp-for="Matricule" class="form-control-custom" />
                        <span asp-validation-for="Matricule" class="text-danger small"></span>
                    </div>
                    
                    <div class="col-md-6">
                        <label asp-for="DateNaissance" class="form-label-custom">
                            <i class="bi bi-calendar"></i> Date de Naissance
                        </label>
                        <input asp-for="DateNaissance" type="date" class="form-control-custom" />
                        <span asp-validation-for="DateNaissance" class="text-danger small"></span>
                    </div>
                    
                    <div class="col-md-6">
                        <label asp-for="Nom" class="form-label-custom">
                            <i class="bi bi-person"></i> Nom *
                        </label>
                        <input asp-for="Nom" class="form-control-custom" />
                        <span asp-validation-for="Nom" class="text-danger small"></span>
                    </div>
                    
                    <div class="col-md-6">
                        <label asp-for="Prenom" class="form-label-custom">
                            <i class="bi bi-person"></i> Prénom *
                        </label>
                        <input asp-for="Prenom" class="form-control-custom" />
                        <span asp-validation-for="Prenom" class="text-danger small"></span>
                    </div>
                    
                    <div class="col-md-6">
                        <label asp-for="Email" class="form-label-custom">
                            <i class="bi bi-envelope"></i> Email Professionnel *
                        </label>
                        <input asp-for="Email" class="form-control-custom" type="email" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>
                    
                    <div class="col-md-6">
                        <label asp-for="Telephone" class="form-label-custom">
                            <i class="bi bi-telephone"></i> Téléphone
                        </label>
                        <input asp-for="Telephone" class="form-control-custom" />
                        <span asp-validation-for="Telephone" class="text-danger small"></span>
                    </div>
                    
                    <div class="col-12">
                        <label asp-for="Adresse" class="form-label-custom">
                            <i class="bi bi-geo-alt"></i> Adresse
                        </label>
                        <textarea asp-for="Adresse" class="form-control-custom" rows="2"></textarea>
                        <span asp-validation-for="Adresse" class="text-danger small"></span>
                    </div>
                </div>

                <h5 class="section-divider">
                    <i class="bi bi-briefcase"></i> Poste et Affectation
                </h5>

                <div class="row g-4 mb-4">
                    <div class="col-md-6">
                        <label asp-for="DepartementId" class="form-label-custom">
                            <i class="bi bi-building"></i> Département *
                        </label>
                        <select asp-for="DepartementId" class="form-control-custom" asp-items="ViewBag.DepartementId">
                            <option value="">-- Sélectionner un département --</option>
                        </select>
                        <span asp-validation-for="DepartementId" class="text-danger small"></span>
                    </div>
                    
                    <div class="col-md-6">
                        <label asp-for="PosteId" class="form-label-custom">
                            <i class="bi bi-briefcase"></i> Poste *
                        </label>
                        <select asp-for="PosteId" class="form-control-custom" asp-items="ViewBag.PosteId">
                            <option value="">-- Sélectionner un poste --</option>
                        </select>
                        <span asp-validation-for="PosteId" class="text-danger small"></span>
                    </div>
                    
                    <div class="col-md-6">
                        <label asp-for="DateEmbauche" class="form-label-custom">
                            <i class="bi bi-calendar-check"></i> Date d'Embauche *
                        </label>
                        <input asp-for="DateEmbauche" type="date" class="form-control-custom" />
                        <span asp-validation-for="DateEmbauche" class="text-danger small"></span>
                    </div>
                    
                    <div class="col-md-6">
                        <label asp-for="Salaire" class="form-label-custom">
                            <i class="bi bi-cash-stack"></i> Salaire *
                        </label>
                        <div class="input-group input-group-custom">
                            <input asp-for="Salaire" class="form-control-custom" type="number" step="0.01" />
                            <span class="input-group-text">DH</span>
                        </div>
                        <span asp-validation-for="Salaire" class="text-danger small"></span>
                    </div>
                </div>

                <div class="row g-4 mb-5">
                    <div class="col-md-6">
                        <label asp-for="SoldeConges" class="form-label-custom">
                            <i class="bi bi-calendar-plus"></i> Solde Congés (Jours) *
                        </label>
                        <input asp-for="SoldeConges" class="form-control-custom" type="number" step="0.5" />
                        <span asp-validation-for="SoldeConges" class="text-danger small"></span>
                    </div>
                    
                    <div class="col-md-6">
                        <div class="status-switch">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" asp-for="EstActif" id="estActifSwitch">
                                <label class="form-check-label fw-bold" for="estActifSwitch">
                                    <i class="bi bi-power"></i> Compte Actif
                                </label>
                            </div>
                            <small class="text-muted d-block mt-2">
                                @if (Model.EstActif)
                                {
                                    <span class="text-success">
                                        <i class="bi bi-check-circle"></i> L'employé peut accéder au système
                                    </span>
                                }
                                else
                                {
                                    <span class="text-danger">
                                        <i class="bi bi-slash-circle"></i> L'employé ne peut pas accéder au système
                                    </span>
                                }
                            </small>
                        </div>
                        <span asp-validation-for="EstActif" class="text-danger small"></span>
                    </div>
                </div>

                <div class="d-flex justify-content-between align-items-center pt-4 border-top">
                    <a asp-action="Index" class="btn btn-outline-secondary-custom">
                        <i class="bi bi-arrow-left"></i> Annuler
                    </a>
                    
                    <button type="submit" class="btn btn-warning-custom">
                        <i class="bi bi-check-circle"></i> Enregistrer les modifications
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    
    <script>
        $(document).ready(function() {
            // Mettre à jour le statut en temps réel
            $('#estActifSwitch').on('change', function() {
                const statusText = $(this).is(':checked') 
                    ? '<span class="text-success"><i class="bi bi-check-circle"></i> L\'employé peut accéder au système</span>'
                    : '<span class="text-danger"><i class="bi bi-slash-circle"></i> L\'employé ne peut pas accéder au système</span>';
                
                $(this).closest('.status-switch').find('small').html(statusText);
            });
        });
    </script>
}