@model IEnumerable<Systeme_RH.Models.ViewModels.EmployeViewModel>

@{
    ViewData["Title"] = "Gestion des Employés";
}

<style>
    .employees-container {
        background: white;
        border-radius: 12px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.08);
        overflow: hidden;
    }

    .page-header {
        background: linear-gradient(135deg, #f8fafc 0%, #e2e8f0 100%);
        padding: 2rem;
        border-bottom: 1px solid #e2e8f0;
    }

    .page-title {
        color: #1e293b;
        font-weight: 700;
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }

    .btn-success-custom {
        background: linear-gradient(135deg, #10b981 0%, #059669 100%);
        border: none;
        color: white;
        font-weight: 600;
        padding: 0.75rem 1.5rem;
        border-radius: 8px;
        transition: all 0.2s ease;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
    }

    .btn-success-custom:hover {
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(16, 185, 129, 0.3);
    }

    .search-card {
        background: #f8fafc;
        border-radius: 10px;
        padding: 1.5rem;
        margin: 1.5rem;
        border-left: 4px solid #2563eb;
    }

    .search-input-group {
        max-width: 800px;
    }

    .input-group-custom .input-group-text {
        background: white;
        border: 1px solid #cbd5e1;
    }

    .input-group-custom .form-control {
        border: 1px solid #cbd5e1;
        padding: 0.75rem;
    }

    .btn-primary-custom {
        background: linear-gradient(135deg, #2563eb 0%, #1e40af 100%);
        border: none;
        color: white;
        font-weight: 600;
        padding: 0.75rem 1.5rem;
        border-radius: 8px;
        transition: all 0.2s ease;
    }

    .btn-primary-custom:hover {
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(37, 99, 235, 0.3);
    }

    .employees-table {
        margin: 0;
    }

    .table-header {
        background: #f1f5f9;
        color: #475569;
        font-weight: 600;
        text-transform: uppercase;
        font-size: 0.85rem;
        letter-spacing: 0.5px;
    }

    .table-header th {
        border-bottom: 2px solid #e2e8f0;
        padding: 1rem 1.5rem;
    }

    .table-body td {
        padding: 1rem 1.5rem;
        vertical-align: middle;
        border-bottom: 1px solid #f1f5f9;
        transition: all 0.2s ease;
    }

    .table-body tr:hover td {
        background-color: #f8fafc;
    }

    .employee-avatar {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        background: linear-gradient(135deg, #2563eb 0%, #1e40af 100%);
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        font-size: 0.9rem;
    }

    .badge-departement {
        background: linear-gradient(135deg, #0ea5e9 0%, #0284c7 100%);
        color: white;
        padding: 0.35rem 0.75rem;
        border-radius: 20px;
        font-size: 0.75rem;
        font-weight: 600;
    }

    .badge-status-active {
        background: linear-gradient(135deg, #10b981 0%, #059669 100%);
        color: white;
        padding: 0.35rem 0.75rem;
        border-radius: 20px;
        font-size: 0.75rem;
        font-weight: 600;
    }

    .badge-status-inactive {
        background: linear-gradient(135deg, #dc2626 0%, #b91c1c 100%);
        color: white;
        padding: 0.35rem 0.75rem;
        border-radius: 20px;
        font-size: 0.75rem;
        font-weight: 600;
    }

    .badge-solde {
        background: linear-gradient(135deg, #8b5cf6 0%, #7c3aed 100%);
        color: white;
        padding: 0.35rem 0.75rem;
        border-radius: 20px;
        font-size: 0.75rem;
        font-weight: 600;
    }

    .account-linked {
        color: #10b981;
        font-size: 1.1rem;
    }

    .action-buttons {
        display: flex;
        gap: 0.5rem;
        justify-content: flex-end;
    }

    .btn-action {
        width: 36px;
        height: 36px;
        border-radius: 8px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        transition: all 0.2s ease;
        border: none;
    }

    .btn-view {
        background: #e0f2fe;
        color: #0ea5e9;
    }

    .btn-view:hover {
        background: #0ea5e9;
        color: white;
        transform: translateY(-2px);
    }

    .btn-edit {
        background: #dbeafe;
        color: #2563eb;
    }

    .btn-edit:hover {
        background: #2563eb;
        color: white;
        transform: translateY(-2px);
    }

    .btn-delete {
        background: #fee2e2;
        color: #dc2626;
    }

    .btn-delete:hover {
        background: #dc2626;
        color: white;
        transform: translateY(-2px);
    }

    .btn-contrats {
        background: #f3f4f6;
        color: #4b5563;
    }

    .btn-contrats:hover {
        background: #4b5563;
        color: white;
        transform: translateY(-2px);
    }

    .no-employees {
        text-align: center;
        padding: 3rem;
        color: #64748b;
    }

    .matricule-cell {
        font-family: 'Courier New', monospace;
        font-weight: 600;
        color: #475569;
    }
</style>

<div class="container-fluid py-4">
    <div class="employees-container">
        <!-- En-tête de la page -->
        <div class="page-header">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h1 class="page-title">
                        <i class="bi bi-people-fill"></i> Gestion des Employés
                    </h1>
                    <p class="text-muted mb-0">Administrez les employés et leurs informations</p>
                </div>
                <a asp-action="Create" class="btn btn-success-custom">
                    <i class="bi bi-person-plus-fill"></i> Nouvel Employé
                </a>
            </div>
        </div>

        <!-- Barre de recherche -->
        <div class="search-card">
            <form asp-controller="Employes" asp-action="Index" method="get">
                <div class="input-group search-input-group">
                    <span class="input-group-text bg-white border-end-0">
                        <i class="bi bi-search"></i>
                    </span>
                    <input type="text" name="searchString" class="form-control border-start-0 border-end-0" 
                           placeholder="Rechercher par nom, prénom ou matricule..." 
                           value="@ViewContext.HttpContext.Request.Query["searchString"]" />
                    <button type="submit" class="btn btn-primary-custom">
                        <i class="bi bi-search"></i> Rechercher
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary-custom">
                        <i class="bi bi-arrow-clockwise"></i> Réinitialiser
                    </a>
                </div>
            </form>
        </div>

        <!-- Table des employés -->
        <div class="table-responsive px-3 pb-3">
            <table class="table employees-table">
                <thead class="table-header">
                    <tr>
                        <th>Matricule</th>
                        <th>Employé</th>
                        <th>Contact</th>
                        <th>Département & Poste</th>
                        <th>Statut</th>
                        <th>Solde Congés</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody class="table-body">
                    @if (Model.Any())
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="matricule-cell">@item.Matricule</td>
                                <td>
                                    <div class="d-flex align-items-center">
                                        <div class="employee-avatar me-3">
                                            @item.Nom[0]@item.Prenom[0]
                                        </div>
                                        <div>
                                            <div class="fw-bold">@item.Nom @item.Prenom</div>
                                            <small class="text-muted">
                                                <i class="bi bi-calendar"></i> @item.DateEmbauche.ToShortDateString()
                                            </small>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <div class="small">
                                        <i class="bi bi-envelope text-primary me-1"></i> @item.Email
                                    </div>
                                    <div class="small">
                                        <i class="bi bi-telephone text-success me-1"></i> @(item.Telephone ?? "-")
                                    </div>
                                </td>
                                <td>
                                    <span class="badge-departement">@item.DepartementNom</span>
                                    <div class="small text-muted mt-1">@item.PosteTitre</div>
                                </td>
                                <td>
                                    @if (item.EstActif)
                                    {
                                        <span class="badge-status-active">
                                            <i class="bi bi-check-circle"></i> Actif
                                        </span>
                                        @if(!string.IsNullOrEmpty(item.ApplicationUserId))
                                        {
                                            <i class="bi bi-link-45deg account-linked ms-1" title="Compte lié"></i>
                                        }
                                    }
                                    else
                                    {
                                        <span class="badge-status-inactive">
                                            <i class="bi bi-slash-circle"></i> Inactif
                                        </span>
                                    }
                                </td>
                                <td>
                                    <span class="badge-solde">
                                        <i class="bi bi-calendar"></i> @item.SoldeConges Jours
                                    </span>
                                </td>
                                <td>
                                    <div class="action-buttons">
                                        <a asp-action="Details" asp-route-id="@item.Id" class="btn-action btn-view" title="Voir Détails">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn-action btn-edit" title="Modifier">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn-action btn-delete" title="Supprimer">
                                            <i class="bi bi-trash"></i>
                                        </a>
                                        <a asp-controller="Contrats" asp-action="Index" asp-route-employeId="@item.Id" class="btn-action btn-contrats" title="Gérer Contrats">
                                            <i class="bi bi-file-earmark-text"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="no-employees">
                                <div class="py-5">
                                    <i class="bi bi-people display-1 text-muted"></i>
                                    <h4 class="mt-3">Aucun employé trouvé</h4>
                                    <p class="text-muted">Commencez par créer votre premier employé</p>
                                    <a asp-action="Create" class="btn btn-success-custom mt-2">
                                        <i class="bi bi-person-plus-fill"></i> Créer un employé
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            // Animation d'entrée des lignes
            $('.table-body tr').each(function(index) {
                $(this).css('opacity', '0');
                setTimeout(() => {
                    $(this).animate({ opacity: 1 }, 300);
                }, index * 100);
            });

            // Confirmation avant suppression
            $('.btn-delete').on('click', function(e) {
                if (!confirm('Êtes-vous sûr de vouloir supprimer cet employé ? Cette action est irréversible.')) {
                    e.preventDefault();
                }
            });
        });
    </script>
}