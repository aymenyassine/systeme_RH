@model Systeme_RH.Models.ViewModels.ContratViewModel

@{
    ViewData["Title"] = "Nouveau Contrat";
}

<style>
    :root {
        --primary-color: #2563eb;
        --primary-dark: #1e40af;
        --secondary-color: #64748b;
        --accent-color: #0ea5e9;
        --success-color: #10b981;
        --warning-color: #f59e0b;
        --danger-color: #ef4444;
        --light-bg: #f8fafc;
        --border-color: #e2e8f0;
        --text-dark: #1e293b;
        --text-muted: #64748b;
    }

    .form-card {
        background: white;
        border: none;
        border-radius: 12px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.08);
        overflow: hidden;
        border-top: 4px solid var(--success-color);
        max-width: 600px;
        margin: 0 auto;
    }

    .form-header {
        background: linear-gradient(135deg, #d1fae5 0%, #a7f3d0 100%);
        padding: 1.5rem 2rem;
        border-bottom: 2px solid #6ee7b7;
    }

    .form-header h4 {
        font-size: 1.3rem;
        font-weight: 600;
        color: #065f46;
        margin: 0;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .form-body {
        padding: 2rem;
    }

    .employe-info {
        background: linear-gradient(135deg, #eff6ff 0%, #dbeafe 100%);
        border: 1px solid #93c5fd;
        border-radius: 8px;
        padding: 1.25rem;
        margin-bottom: 1.5rem;
        display: flex;
        align-items: center;
        gap: 1rem;
    }

    .employe-info i {
        font-size: 1.5rem;
        color: var(--primary-color);
    }

    .employe-info-content h5 {
        color: var(--text-dark);
        font-weight: 600;
        margin: 0 0 0.25rem 0;
    }

    .employe-info-content p {
        color: var(--text-muted);
        margin: 0;
        font-size: 0.9rem;
    }

    .form-label-custom {
        color: var(--text-dark);
        font-weight: 600;
        margin-bottom: 0.5rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .form-control-custom, .form-select-custom {
        border: 2px solid var(--border-color);
        border-radius: 8px;
        padding: 0.75rem 1rem;
        font-size: 1rem;
        transition: all 0.3s ease;
        background-color: white;
    }

    .form-control-custom:focus, .form-select-custom:focus {
        border-color: var(--success-color);
        box-shadow: 0 0 0 3px rgba(16, 185, 129, 0.1);
        transform: translateY(-1px);
    }

    .form-select-custom option {
        padding: 0.5rem;
    }

    .input-group-custom {
        position: relative;
    }

    .input-group-custom .input-group-text {
        background: var(--light-bg);
        border: 2px solid var(--border-color);
        border-right: none;
        border-radius: 8px 0 0 8px;
        color: var(--text-muted);
        font-weight: 500;
    }

    .input-group-custom .form-control-custom {
        border-left: none;
        border-radius: 0 8px 8px 0;
    }

    .date-input-group {
        position: relative;
    }

    .date-input-group i {
        position: absolute;
        left: 1rem;
        top: 50%;
        transform: translateY(-50%);
        color: var(--text-muted);
        pointer-events: none;
    }

    .date-input-group .form-control-custom {
        padding-left: 2.5rem;
    }

    .file-upload-area {
        background: linear-gradient(135deg, #f8fafc 0%, #e2e8f0 100%);
        border: 2px dashed var(--border-color);
        border-radius: 8px;
        padding: 1.5rem;
        text-align: center;
        margin-bottom: 1rem;
        transition: all 0.3s ease;
        cursor: pointer;
    }

    .file-upload-area:hover {
        border-color: var(--success-color);
        background: linear-gradient(135deg, #ecfdf5 0%, #d1fae5 100%);
    }

    .file-upload-area i {
        font-size: 2rem;
        color: var(--success-color);
        margin-bottom: 0.5rem;
    }

    .file-upload-area p {
        color: var(--text-muted);
        margin: 0;
    }

    .file-upload-area input[type="file"] {
        display: none;
    }

    .form-check-custom {
        border: 2px solid var(--border-color);
        border-radius: 8px;
        padding: 1rem;
        margin-bottom: 1.5rem;
        transition: all 0.3s ease;
    }

    .form-check-custom:hover {
        border-color: var(--success-color);
        background-color: #ecfdf5;
    }

    .form-check-custom .form-check-input {
        width: 1.2rem;
        height: 1.2rem;
        margin-right: 0.75rem;
    }

    .form-check-custom .form-check-input:checked {
        background-color: var(--success-color);
        border-color: var(--success-color);
    }

    .form-check-custom .form-check-label {
        color: var(--text-dark);
        font-weight: 500;
        cursor: pointer;
    }

    .btn-success-custom {
        background: linear-gradient(135deg, var(--success-color) 0%, #059669 100%);
        border: none;
        color: white;
        font-weight: 600;
        padding: 0.8rem 2rem;
        border-radius: 8px;
        transition: all 0.3s ease;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        width: 100%;
        justify-content: center;
    }

    .btn-success-custom:hover {
        background: linear-gradient(135deg, #059669 0%, #047857 100%);
        transform: translateY(-2px);
        box-shadow: 0 8px 20px rgba(16, 185, 129, 0.3);
    }

    .btn-secondary-custom {
        background: white;
        border: 2px solid var(--border-color);
        color: var(--text-muted);
        font-weight: 600;
        padding: 0.8rem 2rem;
        border-radius: 8px;
        transition: all 0.3s ease;
        width: 100%;
        margin-top: 1rem;
    }

    .btn-secondary-custom:hover {
        background: var(--light-bg);
        border-color: var(--secondary-color);
        color: var(--text-dark);
        transform: translateY(-2px);
    }

    .validation-summary {
        background: linear-gradient(135deg, #fef2f2 0%, #fee2e2 100%);
        border: 1px solid #fca5a5;
        border-radius: 8px;
        padding: 1rem;
        margin-bottom: 1.5rem;
    }

    .validation-summary ul {
        margin: 0;
        padding-left: 1.5rem;
        color: #991b1b;
    }

    .validation-summary li {
        margin: 0.25rem 0;
    }

    .field-validation-error {
        color: var(--danger-color);
        font-size: 0.875rem;
        margin-top: 0.25rem;
        display: flex;
        align-items: center;
        gap: 0.25rem;
    }

    .form-text-custom {
        color: var(--text-muted);
        font-size: 0.875rem;
        margin-top: 0.25rem;
        display: block;
    }
</style>

<div class="container-fluid">
    <div class="form-card">
        <div class="form-header">
            <h4><i class="bi bi-file-earmark-plus"></i> Créer un Nouveau Contrat</h4>
        </div>
        
        <div class="form-body">
            <form asp-action="Create" enctype="multipart/form-data">
                <input type="hidden" asp-for="EmployeId" />

                <!-- Informations de l'employé -->
                <div class="employe-info">
                    <i class="bi bi-person-circle"></i>
                    <div class="employe-info-content">
                        <h5>Nouveau contrat pour</h5>
                        <p>Identifiant employé : #@Model.EmployeId</p>
                    </div>
                </div>

                <!-- Messages de validation -->
                <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

                <div class="row g-3">
                    <!-- Type de Contrat -->
                    <div class="col-md-6">
                        <label asp-for="TypeContrat" class="form-label-custom">
                            <i class="bi bi-file-earmark-text"></i> Type de Contrat
                        </label>
                        <select asp-for="TypeContrat" class="form-select-custom">
                            <option value="">-- Sélectionner --</option>
                            <option value="CDI">CDI</option>
                            <option value="CDD">CDD</option>
                            <option value="ANAPEC">ANAPEC</option>
                            <option value="Stage">Stage</option>
                            <option value="Freelance">Freelance</option>
                        </select>
                        <span asp-validation-for="TypeContrat" class="field-validation-error"></span>
                    </div>
                    
                    <!-- Salaire Mensuel -->
                    <div class="col-md-6">
                        <label asp-for="SalaireMensuel" class="form-label-custom">
                            <i class="bi bi-cash-stack"></i> Salaire Mensuel
                        </label>
                        <div class="input-group-custom">
                            <span class="input-group-text">DH</span>
                            <input asp-for="SalaireMensuel" type="number" step="0.01" class="form-control-custom" placeholder="0.00" />
                        </div>
                        <span asp-validation-for="SalaireMensuel" class="field-validation-error"></span>
                    </div>
                </div>

                <div class="row g-3 mt-2">
                    <!-- Date de début -->
                    <div class="col-md-6">
                        <label asp-for="DateDebut" class="form-label-custom">
                            <i class="bi bi-calendar-check"></i> Date de début
                        </label>
                        <div class="date-input-group">
                            <i class="bi bi-calendar"></i>
                            <input asp-for="DateDebut" type="date" class="form-control-custom" />
                        </div>
                        <span asp-validation-for="DateDebut" class="field-validation-error"></span>
                    </div>

                    <!-- Date de fin -->
                    <div class="col-md-6">
                        <label asp-for="DateFin" class="form-label-custom">
                            <i class="bi bi-calendar-x"></i> Date de fin (Optionnel)
                        </label>
                        <div class="date-input-group">
                            <i class="bi bi-calendar"></i>
                            <input asp-for="DateFin" type="date" class="form-control-custom" />
                        </div>
                        <span asp-validation-for="DateFin" class="field-validation-error"></span>
                        <span class="form-text-custom">Laisser vide pour un CDI ou contrat à durée indéterminée</span>
                    </div>
                </div>

                <!-- Pièce jointe -->
                <div class="mt-4">
                    <label class="form-label-custom">
                        <i class="bi bi-paperclip"></i> Pièce jointe
                    </label>
                    
                    <div class="file-upload-area" onclick="document.getElementById('fichierJoint').click()">
                        <i class="bi bi-cloud-arrow-up-fill"></i>
                        <p class="mb-1">Cliquer pour téléverser un fichier</p>
                        <small class="text-muted">PDF ou Image (max 5MB)</small>
                        <input type="file" id="fichierJoint" name="fichierJoint" class="form-control-custom d-none" 
                               accept=".pdf,.jpg,.jpeg,.png" onchange="updateFileName(this)" />
                    </div>
                    <div id="fileName" class="text-center mt-2"></div>
                    <span class="form-text-custom">Contrat signé scanné ou document officiel</span>
                </div>

                <!-- Statut actif -->
                <div class="form-check-custom mt-4">
                    <input class="form-check-input" type="checkbox" asp-for="EstActif" checked />
                    <label class="form-check-label" asp-for="EstActif">
                        Contrat Actif (En cours)
                    </label>
                    <div class="form-text-custom">Décocher pour créer un contrat déjà terminé</div>
                </div>

                <!-- Boutons d'action -->
                <div class="mt-4">
                    <button type="submit" class="btn-success-custom">
                        <i class="bi bi-plus-circle-fill me-2"></i> Enregistrer le Contrat
                    </button>
                    <a asp-action="Index" asp-route-employeId="@Model.EmployeId" class="btn-secondary-custom">
                        <i class="bi bi-x-circle me-2"></i> Annuler
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    
    <script>
        $(document).ready(function() {
            // Afficher la date d'aujourd'hui par défaut pour DateDebut
            const today = new Date().toISOString().split('T')[0];
            $('#DateDebut').val(today);
            
            // Mise à jour du nom du fichier
            window.updateFileName = function(input) {
                if (input.files && input.files[0]) {
                    $('#fileName').html(`
                        <div class="alert alert-success d-inline-flex align-items-center py-1">
                            <i class="bi bi-check-circle-fill me-2"></i>
                            ${input.files[0].name}
                        </div>
                    `);
                }
            };

            // Validation du type et taille de fichier
            $('#fichierJoint').on('change', function() {
                const file = this.files[0];
                if (file) {
                    const fileSize = file.size / 1024 / 1024; // en MB
                    const allowedTypes = ['application/pdf', 'image/jpeg', 'image/jpg', 'image/png'];
                    
                    if (!allowedTypes.includes(file.type)) {
                        alert('Seuls les fichiers PDF, JPG et PNG sont acceptés.');
                        $(this).val('');
                        $('#fileName').html('');
                        return;
                    }
                    
                    if (fileSize > 5) {
                        alert('Le fichier doit faire moins de 5MB.');
                        $(this).val('');
                        $('#fileName').html('');
                    }
                }
            });

            // Auto-sélection du champ TypeContrat
            $('#TypeContrat').focus();
        });
    </script>
}