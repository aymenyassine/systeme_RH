@model IEnumerable<Systeme_RH.Models.ViewModels.ContratViewModel>

@{
    ViewData["Title"] = "Liste des Contrats";
    
    // Récupération sécurisée de l'ID et du Nom
    int? employeId = ViewBag.EmployeId as int?;
    string employeNom = ViewBag.EmployeNom ?? "Tous les employés";
    
    // Booléen pour savoir si on est en mode "Liste Globale"
    bool isGlobalList = !employeId.HasValue;
}

<style>
    :root {
        --primary-color: #2563eb;
        --primary-dark: #1e40af;
        --secondary-color: #64748b;
        --accent-color: #0ea5e9;
        --success-color: #10b981;
        --warning-color: #f59e0b;
        --danger-color: #ef4444;
        --light-bg: #f8fafc;
        --border-color: #e2e8f0;
        --text-dark: #1e293b;
        --text-muted: #64748b;
    }

    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 2.5rem;
        padding-bottom: 1rem;
        border-bottom: 2px solid var(--border-color);
    }

    .page-header h1 {
        font-size: 1.8rem;
        font-weight: 700;
        color: var(--text-dark);
        margin: 0;
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }

    .page-header h1 i {
        color: var(--primary-color);
        font-size: 1.5rem;
    }

    .page-subtitle {
        color: var(--text-muted);
        font-size: 1rem;
        margin-top: 0.5rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .btn-primary-custom {
        background: linear-gradient(135deg, var(--primary-color) 0%, var(--primary-dark) 100%);
        border: none;
        color: white;
        font-weight: 600;
        padding: 0.8rem 1.5rem;
        border-radius: 8px;
        transition: all 0.3s ease;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
    }

    .btn-primary-custom:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 20px rgba(37, 99, 235, 0.3);
    }

    .btn-success-custom {
        background: linear-gradient(135deg, var(--success-color) 0%, #059669 100%);
        border: none;
        color: white;
        font-weight: 600;
        padding: 0.8rem 1.5rem;
        border-radius: 8px;
        transition: all 0.3s ease;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
    }

    .btn-success-custom:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 20px rgba(16, 185, 129, 0.3);
    }

    .table-container {
        background: white;
        border-radius: 12px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.08);
        overflow: hidden;
        margin-bottom: 2rem;
    }

    .table-header {
        background: linear-gradient(135deg, #f8fafc 0%, #e2e8f0 100%);
        padding: 1.5rem 2rem;
        border-bottom: 2px solid var(--border-color);
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .table-header h5 {
        font-size: 1.1rem;
        font-weight: 600;
        color: var(--text-dark);
        margin: 0;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .table-responsive {
        overflow-x: auto;
    }

    .table-custom {
        width: 100%;
        border-collapse: separate;
        border-spacing: 0;
    }

    .table-custom thead th {
        background-color: #f8fafc;
        color: var(--text-dark);
        font-weight: 600;
        text-transform: uppercase;
        font-size: 0.85rem;
        letter-spacing: 0.5px;
        padding: 1rem;
        border-bottom: 2px solid var(--border-color);
        white-space: nowrap;
    }

    .table-custom tbody tr {
        transition: all 0.2s ease;
        border-bottom: 1px solid var(--border-color);
    }

    .table-custom tbody tr:hover {
        background-color: #f8fafc;
        transform: translateX(5px);
    }

    .table-custom tbody tr.contract-active {
        border-left: 4px solid var(--success-color);
    }

    .table-custom tbody tr.contract-inactive {
        border-left: 4px solid var(--secondary-color);
        background-color: #f8f9fa;
    }

    .table-custom tbody td {
        padding: 1rem;
        vertical-align: middle;
        white-space: nowrap;
    }

    .badge-custom {
        padding: 0.4rem 0.8rem;
        border-radius: 6px;
        font-weight: 500;
        font-size: 0.85rem;
    }

    .badge-custom.secondary {
        background-color: #e2e8f0;
        color: #475569;
    }

    .badge-custom.success {
        background-color: #d1fae5;
        color: #065f46;
    }

    .badge-custom.warning {
        background-color: #fef3c7;
        color: #92400e;
    }

    .employee-link {
        color: var(--text-dark);
        text-decoration: none;
        font-weight: 600;
        transition: color 0.2s ease;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
    }

    .employee-link:hover {
        color: var(--primary-color);
        text-decoration: none;
    }

    .date-range {
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
    }

    .date-item {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 0.9rem;
    }

    .date-item.start i {
        color: var(--success-color);
    }

    .date-item.end i {
        color: var(--danger-color);
    }

    .salary-cell {
        font-weight: 700;
        color: var(--text-dark);
        font-size: 1.1rem;
    }

    .salary-suffix {
        font-size: 0.85rem;
        color: var(--text-muted);
        margin-left: 0.25rem;
    }

    .btn-action {
        width: 36px;
        height: 36px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 8px;
        transition: all 0.2s ease;
        border: none;
        margin: 0 2px;
    }

    .btn-action.info {
        background-color: #dbeafe;
        color: var(--primary-color);
    }

    .btn-action.info:hover {
        background-color: var(--primary-color);
        color: white;
        transform: scale(1.1);
    }

    .btn-action.warning {
        background-color: #fef3c7;
        color: var(--warning-color);
    }

    .btn-action.warning:hover {
        background-color: var(--warning-color);
        color: white;
        transform: scale(1.1);
    }

    .btn-action.danger {
        background-color: #fee2e2;
        color: var(--danger-color);
    }

    .btn-action.danger:hover {
        background-color: var(--danger-color);
        color: white;
        transform: scale(1.1);
    }

    .empty-state {
        padding: 4rem 2rem;
        text-align: center;
        color: var(--text-muted);
    }

    .empty-state i {
        font-size: 3rem;
        opacity: 0.5;
        margin-bottom: 1rem;
    }

    .empty-state h4 {
        color: var(--text-dark);
        margin-bottom: 0.5rem;
        font-weight: 600;
    }

    .empty-state p {
        margin-bottom: 1.5rem;
    }

    .alert-custom {
        border-radius: 8px;
        border: none;
        box-shadow: 0 2px 8px rgba(0,0,0,0.06);
        margin-bottom: 1.5rem;
        padding: 1rem 1.5rem;
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }

    .alert-custom.success {
        background: linear-gradient(135deg, #d1fae5 0%, #a7f3d0 100%);
        color: #065f46;
    }

    .alert-custom.danger {
        background: linear-gradient(135deg, #fee2e2 0%, #fecaca 100%);
        color: #991b1b;
    }

    .alert-custom i {
        font-size: 1.25rem;
    }

    .stats-card {
        background: white;
        border-radius: 12px;
        padding: 1.5rem;
        box-shadow: 0 2px 8px rgba(0,0,0,0.06);
        margin-bottom: 1.5rem;
    }

    .stats-card h6 {
        color: var(--text-muted);
        font-size: 0.9rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        margin-bottom: 0.5rem;
    }

    .stats-card .stat-value {
        font-size: 1.8rem;
        font-weight: 700;
        color: var(--text-dark);
        margin-bottom: 0.5rem;
    }

    .stats-card .stat-change {
        font-size: 0.85rem;
        color: var(--success-color);
        display: flex;
        align-items: center;
        gap: 0.25rem;
    }
</style>

<div class="container-fluid">
    <!-- En-tête de la page -->
    <div class="page-header">
        <div>
            <h1><i class="bi bi-file-earmark-text"></i> Gestion des Contrats</h1>
            <div class="page-subtitle">
                <i class="bi @(isGlobalList ? "bi-globe" : "bi-person")"></i>
                <span>
                    @if (isGlobalList)
                    {
                        <span>Vue Globale - Tous les contrats</span>
                    }
                    else
                    {
                        <span>Employé : <strong class="text-primary">@employeNom</strong></span>
                    }
                </span>
            </div>
        </div>
        
        <div>
            @if (!isGlobalList)
            {
                <!-- CAS 1 : On est sur un employé précis -> On peut créer direct -->
                <a asp-action="Create" asp-route-employeId="@employeId" class="btn-success-custom">
                    <i class="bi bi-plus-lg"></i> Nouveau Contrat
                </a>
            }
            else
            {
                <!-- CAS 2 : Vue globale -> On redirige vers la liste des employés -->
                <a asp-controller="Employes" asp-action="Index" class="btn-primary-custom" title="Sélectionner un employé pour créer un contrat">
                    <i class="bi bi-person-plus"></i> Affecter un Contrat
                </a>
            }

            <a asp-controller="Employes" asp-action="Index" class="btn btn-outline-secondary ms-2">
                <i class="bi bi-people"></i> Liste Employés
            </a>
        </div>
    </div>

    <!-- Messages d'alerte -->
    @if (TempData["Success"] != null)
    {
        <div class="alert-custom success">
            <i class="bi bi-check-circle-fill"></i>
            <span>@TempData["Success"]</span>
            <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Statistiques -->
    @if (Model.Any())
    {
        <div class="row g-3 mb-4">
            <div class="col-md-3">
                <div class="stats-card">
                    <h6>Total Contrats</h6>
                    <div class="stat-value">@Model.Count()</div>
                    <div class="stat-change">
                        <i class="bi bi-graph-up-arrow"></i>
                        <span>@Model.Count(c => c.EstActif) actifs</span>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="stats-card">
                    <h6>CDI</h6>
                    <div class="stat-value">@Model.Count(c => c.TypeContrat.ToString() == "CDI")</div>
                    <div class="stat-change">
                        <i class="bi bi-briefcase"></i>
                        <span>Contrats permanents</span>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="stats-card">
                    <h6>CDD & Stages</h6>
                    <div class="stat-value">@Model.Count(c => c.TypeContrat.ToString() == "CDD" || c.TypeContrat.ToString() == "Stage")</div>
                    <div class="stat-change">
                        <i class="bi bi-calendar"></i>
                        <span>Contrats temporaires</span>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="stats-card">
                    <h6>Moyenne Salaire</h6>
                    <div class="stat-value">@Model.Average(c => c.SalaireMensuel).ToString("N0")</div>
                    <div class="stat-change">
                        <i class="bi bi-cash"></i>
                        <span>DH / mois</span>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- Tableau des contrats -->
    <div class="table-container">
        <div class="table-header">
            <h5><i class="bi bi-list-ul"></i> Liste des Contrats</h5>
            <div class="text-muted small">
                <i class="bi bi-info-circle"></i> 
                @Model.Count() contrat(s) trouvé(s)
            </div>
        </div>
        
        <div class="table-responsive">
            @if (!Model.Any())
            {
                <div class="empty-state">
                    <i class="bi bi-inbox"></i>
                    <h4 class="mt-3">Aucun contrat trouvé</h4>
                    <p>Commencez par créer votre premier contrat.</p>
                    @if (!isGlobalList)
                    {
                        <a asp-action="Create" asp-route-employeId="@employeId" class="btn-success-custom">
                            <i class="bi bi-plus-lg"></i> Créer un Contrat
                        </a>
                    }
                    else
                    {
                        <a asp-controller="Employes" asp-action="Index" class="btn-primary-custom">
                            <i class="bi bi-person-plus"></i> Sélectionner un Employé
                        </a>
                    }
                </div>
            }
            else
            {
                <table class="table-custom">
                    <thead>
                        <tr>
                            @if (isGlobalList)
                            {
                                <th>Employé</th>
                            }
                            <th>Type</th>
                            <th>Période</th>
                            <th>Salaire</th>
                            <th>Statut</th>
                            <th>Document</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr class="@(item.EstActif ? "contract-active" : "contract-inactive")">
                                
                                @if (isGlobalList)
                                {
                                    <td>
                                        <a asp-action="Index" asp-route-employeId="@item.EmployeId" class="employee-link">
                                            <i class="bi bi-person-circle"></i>
                                            @item.EmployeNom
                                        </a>
                                    </td>
                                }

                                <td>
                                    <span class="badge-custom @(item.TypeContrat.ToString() == "CDI" ? "success" : "secondary")">
                                        @item.TypeContrat
                                    </span>
                                </td>
                                
                                <td>
                                    <div class="date-range">
                                        <div class="date-item start">
                                            <i class="bi bi-calendar-check"></i>
                                            @item.DateDebut.ToString("dd/MM/yyyy")
                                        </div>
                                        @if (item.DateFin.HasValue)
                                        {
                                            <div class="date-item end">
                                                <i class="bi bi-calendar-x"></i>
                                                @item.DateFin.Value.ToString("dd/MM/yyyy")
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="date-item">
                                                <i class="bi bi-infinity text-muted"></i>
                                                <span class="text-muted">Durée indéterminée</span>
                                            </div>
                                        }
                                    </div>
                                </td>
                                
                                <td class="salary-cell">
                                    @item.SalaireMensuel.ToString("N2") <span class="salary-suffix">DH</span>
                                </td>
                                
                                <td>
                                    @if (item.EstActif)
                                    {
                                        <span class="badge-custom success">
                                            <i class="bi bi-check-circle me-1"></i> En Cours
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge-custom secondary">
                                            <i class="bi bi-x-circle me-1"></i> Clôturé
                                        </span>
                                    }
                                </td>
                                
                                <td>
                                    @if (!string.IsNullOrEmpty(item.PieceJointeUrl))
                                    {
                                        <a href="@item.PieceJointeUrl" target="_blank" class="btn-action info" title="Voir le document">
                                            <i class="bi bi-paperclip"></i>
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">-</span>
                                    }
                                </td>
                                
                                <td class="text-end">
                                    <div class="d-flex justify-content-end gap-1">
                                        <a asp-action="Details" asp-route-id="@item.Id" class="btn-action info" title="Détails">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn-action warning" title="Modifier">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        
                                        @if (item.EstActif)
                                        {
                                            <a asp-action="Terminer" asp-route-id="@item.Id" class="btn-action danger" title="Clôturer le contrat">
                                                <i class="bi bi-slash-circle"></i>
                                            </a>
                                        }
                                        
                                        <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline" 
                                              onsubmit="return confirm('Voulez-vous vraiment supprimer définitivement ce contrat ?');">
                                            <button type="submit" class="btn-action danger" title="Supprimer">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>
</div>

<script>
    $(document).ready(function() {
        // Confirmation pour la suppression
        $('form[action*="Delete"]').on('submit', function(e) {
            if (!confirm('⚠️ ATTENTION ⚠️\n\nCette action supprimera définitivement le contrat.\nÊtes-vous sûr de vouloir continuer ?')) {
                e.preventDefault();
                return false;
            }
        });

        // Animation des lignes
        $('tbody tr').hover(
            function() {
                $(this).css('transform', 'translateX(5px)');
            },
            function() {
                $(this).css('transform', 'translateX(0)');
            }
        );
    });
</script>