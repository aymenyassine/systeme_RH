@model Systeme_RH.Models.ViewModels.PosteViewModel

@{
    ViewData["Title"] = "Détails Poste";
}

<style>
    .poste-details-card {
        background: white;
        border: none;
        border-radius: 12px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.08);
        overflow: hidden;
    }

    .card-header-details {
        background: linear-gradient(135deg, #0ea5e9 0%, #0284c7 100%);
        color: white;
        padding: 1.5rem;
        border-bottom: none;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .card-header-details h3 {
        font-weight: 600;
        margin: 0;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .poste-id-badge {
        background: rgba(255,255,255,0.2);
        color: white;
        padding: 0.5rem 1rem;
        border-radius: 20px;
        font-size: 0.9rem;
        font-weight: 600;
    }

    .poste-content {
        padding: 2rem;
    }

    .section-title {
        color: #1e293b;
        font-weight: 600;
        margin-bottom: 1.5rem;
        padding-bottom: 0.5rem;
        border-bottom: 2px solid #e2e8f0;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .info-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 2rem;
        margin-bottom: 2rem;
    }

    .info-card {
        background: #f8fafc;
        border-radius: 10px;
        padding: 1.5rem;
        border-left: 4px solid #0ea5e9;
    }

    .info-label {
        color: #64748b;
        font-size: 0.9rem;
        font-weight: 500;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        margin-bottom: 0.5rem;
    }

    .info-value {
        color: #1e293b;
        font-size: 1.25rem;
        font-weight: 700;
    }

    .badge-departement {
        background: linear-gradient(135deg, #0ea5e9 0%, #0284c7 100%);
        color: white;
        padding: 0.5rem 1rem;
        border-radius: 20px;
        font-size: 0.9rem;
        font-weight: 600;
    }

    .badge-effectif {
        background: linear-gradient(135deg, #10b981 0%, #059669 100%);
        color: white;
        padding: 0.5rem 1rem;
        border-radius: 20px;
        font-size: 0.9rem;
        font-weight: 600;
    }

    .description-card {
        background: #f8fafc;
        border-radius: 10px;
        padding: 1.5rem;
        margin-top: 1rem;
        border-left: 4px solid #10b981;
    }

    .description-text {
        color: #475569;
        line-height: 1.6;
        white-space: pre-line;
    }

    .empty-description {
        color: #94a3b8;
        font-style: italic;
    }

    .card-footer-details {
        background: #f8fafc;
        padding: 1.5rem;
        border-top: 1px solid #e2e8f0;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .btn-primary-custom {
        background: linear-gradient(135deg, #2563eb 0%, #1e40af 100%);
        border: none;
        color: white;
        font-weight: 600;
        padding: 0.75rem 1.5rem;
        border-radius: 8px;
        transition: all 0.2s ease;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
    }

    .btn-primary-custom:hover {
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(37, 99, 235, 0.3);
    }
</style>

<div class="container-fluid py-4">
    <div class="poste-details-card">
        <div class="card-header-details">
            <h3><i class="bi bi-briefcase-fill"></i> @Model.Titre</h3>
            <span class="poste-id-badge">
                <i class="bi bi-hash"></i> ID: @Model.Id
            </span>
        </div>
        
        <div class="poste-content">
            <h5 class="section-title">
                <i class="bi bi-info-circle"></i> Informations Générales
            </h5>

            <div class="info-grid">
                <div class="info-card">
                    <div class="info-label">
                        <i class="bi bi-building"></i> Département
                    </div>
                    <div class="info-value">
                        <span class="badge-departement">@Model.DepartementNom</span>
                    </div>
                </div>

                <div class="info-card">
                    <div class="info-label">
                        <i class="bi bi-currency-dollar"></i> Salaire de Référence
                    </div>
                    <div class="info-value text-success">
                        @Model.Salaire.ToString("N2") DH
                        <small class="text-muted d-block mt-1">Salaire mensuel de base</small>
                    </div>
                </div>

                <div class="info-card">
                    <div class="info-label">
                        <i class="bi bi-people"></i> Effectif Actuel
                    </div>
                    <div class="info-value">
                        <span class="badge-effectif">
                            <i class="bi bi-person-fill"></i> @Model.NombreEmployes employé(s)
                        </span>
                    </div>
                </div>
            </div>

            <h5 class="section-title">
                <i class="bi bi-card-text"></i> Description du Poste
            </h5>

            <div class="description-card">
                @if (!string.IsNullOrEmpty(Model.Description))
                {
                    <div class="description-text">@Model.Description</div>
                }
                else
                {
                    <div class="description-text empty-description">
                        <i class="bi bi-info-circle"></i> Aucune description n'a été fournie pour ce poste
                    </div>
                }
            </div>
        </div>

        <div class="card-footer-details">
            <a asp-action="Index" class="btn btn-outline-secondary-custom">
                <i class="bi bi-arrow-left"></i> Retour à la liste
            </a>
            
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary-custom">
                <i class="bi bi-pencil-square"></i> Modifier le poste
            </a>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            // Animation d'entrée
            $('.info-card, .description-card').each(function(index) {
                $(this).css('opacity', '0').css('transform', 'translateY(20px)');
                setTimeout(() => {
                    $(this).animate({
                        opacity: 1,
                        transform: 'translateY(0)'
                    }, 300);
                }, index * 100);
            });
        });
    </script>
}