@model IEnumerable<Systeme_RH.Models.ViewModels.PosteViewModel>

@{
    ViewData["Title"] = "Gestion des Postes";
}

<style>
    .postes-container {
        background: white;
        border-radius: 12px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.08);
        overflow: hidden;
    }

    .page-header {
        background: linear-gradient(135deg, #f8fafc 0%, #e2e8f0 100%);
        padding: 2rem;
        border-bottom: 1px solid #e2e8f0;
    }

    .page-title {
        color: #1e293b;
        font-weight: 700;
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }

    .btn-success-custom {
        background: linear-gradient(135deg, #10b981 0%, #059669 100%);
        border: none;
        color: white;
        font-weight: 600;
        padding: 0.75rem 1.5rem;
        border-radius: 8px;
        transition: all 0.2s ease;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
    }

    .btn-success-custom:hover {
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(16, 185, 129, 0.3);
    }

    .filters-card {
        background: #f8fafc;
        border-radius: 10px;
        padding: 1.5rem;
        margin-bottom: 2rem;
        border-left: 4px solid #0ea5e9;
    }

    .filter-label {
        color: #1e293b;
        font-weight: 600;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .form-select-sm-custom {
        border: 1px solid #cbd5e1;
        border-radius: 8px;
        padding: 0.5rem;
        transition: all 0.2s ease;
    }

    .form-select-sm-custom:focus {
        border-color: #2563eb;
        box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.1);
    }

    .postes-table {
        margin: 0;
    }

    .table-header {
        background: #f1f5f9;
        color: #475569;
        font-weight: 600;
        text-transform: uppercase;
        font-size: 0.85rem;
        letter-spacing: 0.5px;
    }

    .table-header th {
        border-bottom: 2px solid #e2e8f0;
        padding: 1rem 1.5rem;
    }

    .table-body td {
        padding: 1rem 1.5rem;
        vertical-align: middle;
        border-bottom: 1px solid #f1f5f9;
        transition: all 0.2s ease;
    }

    .table-body tr:hover td {
        background-color: #f8fafc;
    }

    .badge-departement {
        background: linear-gradient(135deg, #0ea5e9 0%, #0284c7 100%);
        color: white;
        padding: 0.35rem 0.75rem;
        border-radius: 20px;
        font-size: 0.75rem;
        font-weight: 600;
    }

    .badge-effectif {
        background: linear-gradient(135deg, #10b981 0%, #059669 100%);
        color: white;
        padding: 0.35rem 0.75rem;
        border-radius: 20px;
        font-size: 0.75rem;
        font-weight: 600;
    }

    .badge-zero-effectif {
        background: linear-gradient(135deg, #94a3b8 0%, #64748b 100%);
        color: white;
        padding: 0.35rem 0.75rem;
        border-radius: 20px;
        font-size: 0.75rem;
        font-weight: 600;
    }

    .salaire-cell {
        font-weight: 600;
        color: #059669;
    }

    .action-buttons {
        display: flex;
        gap: 0.5rem;
        justify-content: flex-end;
    }

    .btn-action {
        width: 36px;
        height: 36px;
        border-radius: 8px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        transition: all 0.2s ease;
        border: none;
    }

    .btn-edit {
        background: #dbeafe;
        color: #2563eb;
    }

    .btn-edit:hover {
        background: #2563eb;
        color: white;
        transform: translateY(-2px);
    }

    .btn-view {
        background: #e0f2fe;
        color: #0ea5e9;
    }

    .btn-view:hover {
        background: #0ea5e9;
        color: white;
        transform: translateY(-2px);
    }

    .btn-delete {
        background: #fee2e2;
        color: #dc2626;
    }

    .btn-delete:hover {
        background: #dc2626;
        color: white;
        transform: translateY(-2px);
    }

    .no-postes {
        text-align: center;
        padding: 3rem;
        color: #64748b;
    }

    .poste-icon-cell {
        width: 40px;
        color: #0ea5e9;
    }
</style>

<div class="container-fluid py-4">
    <div class="postes-container">
        <!-- En-tête de la page -->
        <div class="page-header">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h1 class="page-title">
                        <i class="bi bi-briefcase-fill"></i> Gestion des Postes
                    </h1>
                    <p class="text-muted mb-0">Administrez les postes et leurs caractéristiques</p>
                </div>
                <a asp-action="Create" class="btn btn-success-custom">
                    <i class="bi bi-plus-lg"></i> Nouveau Poste
                </a>
            </div>
        </div>

        <!-- Messages temporaires -->
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show mx-3 mt-3" role="alert">
                <div class="d-flex align-items-center">
                    <i class="bi bi-check-circle-fill fs-4 me-2"></i>
                    <div>@TempData["Success"]</div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show mx-3 mt-3" role="alert">
                <div class="d-flex align-items-center">
                    <i class="bi bi-exclamation-triangle-fill fs-4 me-2"></i>
                    <div>@TempData["Error"]</div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        <!-- Filtres -->
        <div class="px-3 pt-3">
            <div class="filters-card">
                <form asp-action="Index" method="get" class="row g-3 align-items-center">
                    <div class="col-auto">
                        <label class="filter-label">
                            <i class="bi bi-funnel"></i> Filtrer par département
                        </label>
                    </div>
                    <div class="col-auto">
                        <select name="departementId" class="form-select form-select-sm-custom" 
                                asp-items="ViewBag.DepartementId" 
                                onchange="this.form.submit()">
                            <option value="">-- Tous les départements --</option>
                        </select>
                    </div>
                    <div class="col-auto ms-auto">
                        <span class="text-muted small">
                            <i class="bi bi-info-circle"></i> @Model.Count() poste(s) trouvé(s)
                        </span>
                    </div>
                </form>
            </div>
        </div>

        <!-- Table des postes -->
        <div class="table-responsive px-3 pb-3">
            <table class="table postes-table">
                <thead class="table-header">
                    <tr>
                        <th class="poste-icon-cell"></th>
                        <th>Titre du Poste</th>
                        <th>Département</th>
                        <th>Salaire de Référence</th>
                        <th>Effectif</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody class="table-body">
                    @if (Model.Any())
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="poste-icon-cell">
                                    <i class="bi bi-briefcase"></i>
                                </td>
                                <td>
                                    <div class="fw-bold">@item.Titre</div>
                                    @if (!string.IsNullOrEmpty(item.Description) && item.Description.Length > 50)
                                    {
                                        <small class="text-muted">@item.Description.Substring(0, 50)...</small>
                                    }
                                    else if (!string.IsNullOrEmpty(item.Description))
                                    {
                                        <small class="text-muted">@item.Description</small>
                                    }
                                </td>
                                <td>
                                    <span class="badge-departement">@item.DepartementNom</span>
                                </td>
                                <td class="salaire-cell">
                                    @item.Salaire.ToString("N2") DH
                                </td>
                                <td>
                                    @if (item.NombreEmployes > 0)
                                    {
                                        <span class="badge-effectif">
                                            <i class="bi bi-person-fill"></i> @item.NombreEmployes
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge-zero-effectif">
                                            <i class="bi bi-person"></i> Aucun
                                        </span>
                                    }
                                </td>
                                <td>
                                    <div class="action-buttons">
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn-action btn-edit" title="Modifier">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <a asp-action="Details" asp-route-id="@item.Id" class="btn-action btn-view" title="Détails">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn-action btn-delete" title="Supprimer">
                                            <i class="bi bi-trash"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="no-postes">
                                <div class="py-5">
                                    <i class="bi bi-briefcase display-1 text-muted"></i>
                                    <h4 class="mt-3">Aucun poste trouvé</h4>
                                    <p class="text-muted">Commencez par créer votre premier poste</p>
                                    <a asp-action="Create" class="btn btn-success-custom mt-2">
                                        <i class="bi bi-plus-lg"></i> Créer un poste
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            // Animation d'entrée des lignes
            $('.table-body tr').each(function(index) {
                $(this).css('opacity', '0');
                setTimeout(() => {
                    $(this).animate({ opacity: 1 }, 300);
                }, index * 100);
            });

            // Confirmation avant suppression
            $('.btn-delete').on('click', function(e) {
                if (!confirm('Êtes-vous sûr de vouloir supprimer ce poste ? Cette action est irréversible.')) {
                    e.preventDefault();
                }
            });
        });
    </script>
}