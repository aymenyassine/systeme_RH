@model Systeme_RH.Models.ViewModels.PosteViewModel

@{
    ViewData["Title"] = "Supprimer Poste";
}

<style>
    .delete-container {
        max-width: 700px;
        margin: 0 auto;
    }

    .warning-banner {
        background: linear-gradient(135deg, #fef3c7 0%, #fde68a 100%);
        border: 2px solid #f59e0b;
        border-radius: 12px;
        padding: 1.5rem;
        margin-bottom: 2rem;
    }

    .warning-banner h4 {
        color: #d97706;
        font-weight: 700;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .delete-card {
        background: white;
        border: none;
        border-radius: 12px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.08);
        overflow: hidden;
    }

    .card-header-danger {
        background: linear-gradient(135deg, #dc2626 0%, #b91c1c 100%);
        color: white;
        padding: 1.5rem;
        border-bottom: none;
        text-align: center;
    }

    .poste-summary {
        padding: 2rem;
    }

    .poste-header {
        text-align: center;
        margin-bottom: 2rem;
    }

    .poste-icon {
        font-size: 3rem;
        color: #dc2626;
        margin-bottom: 1rem;
    }

    .poste-details {
        background: #f8fafc;
        border-radius: 10px;
        padding: 1.5rem;
        margin: 1.5rem 0;
    }

    .detail-row {
        display: flex;
        justify-content: space-between;
        padding: 0.75rem 0;
        border-bottom: 1px solid #e2e8f0;
    }

    .detail-row:last-child {
        border-bottom: none;
    }

    .detail-label {
        font-weight: 600;
        color: #475569;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .detail-value {
        color: #1e293b;
        font-weight: 500;
    }

    .alert-warning-custom {
        background: linear-gradient(135deg, #fef3c7 0%, #fde68a 100%);
        border: 1px solid #f59e0b;
        border-radius: 8px;
        padding: 1rem;
    }

    .btn-danger-custom {
        background: linear-gradient(135deg, #dc2626 0%, #b91c1c 100%);
        border: none;
        color: white;
        font-weight: 600;
        padding: 0.75rem 1.5rem;
        border-radius: 8px;
        transition: all 0.2s ease;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
    }

    .btn-danger-custom:hover {
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(220, 38, 38, 0.3);
    }

    .btn-danger-custom:disabled {
        background: linear-gradient(135deg, #94a3b8 0%, #64748b 100%);
        cursor: not-allowed;
        transform: none;
        box-shadow: none;
    }
</style>

<div class="container-fluid py-5">
    <div class="delete-container">
        <!-- Messages temporaires -->
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="bi bi-exclamation-octagon-fill"></i> @TempData["Error"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        <div class="warning-banner">
            <h4><i class="bi bi-exclamation-triangle-fill"></i> Zone de Danger</h4>
            <p class="mb-0">
                Vous êtes sur le point de supprimer définitivement un poste. 
                <strong class="text-danger">Cette action est irréversible.</strong>
            </p>
        </div>

        <div class="delete-card">
            <div class="card-header-danger">
                <h5 class="mb-0"><i class="bi bi-trash-fill"></i> Confirmation de suppression</h5>
            </div>
            
            <div class="poste-summary">
                <div class="poste-header">
                    <div class="poste-icon">
                        <i class="bi bi-briefcase"></i>
                    </div>
                    <h3 class="mb-2">@Model.Titre</h3>
                    <p class="text-muted">ID: @Model.Id</p>
                </div>

                <div class="poste-details">
                    <div class="detail-row">
                        <span class="detail-label">
                            <i class="bi bi-briefcase"></i> Titre du poste
                        </span>
                        <span class="detail-value fw-bold">@Model.Titre</span>
                    </div>
                    
                    <div class="detail-row">
                        <span class="detail-label">
                            <i class="bi bi-building"></i> Département
                        </span>
                        <span class="detail-value">@Model.DepartementNom</span>
                    </div>
                    
                    <div class="detail-row">
                        <span class="detail-label">
                            <i class="bi bi-currency-dollar"></i> Salaire de référence
                        </span>
                        <span class="detail-value text-success">@Model.Salaire.ToString("N2") DH</span>
                    </div>
                    
                    <div class="detail-row">
                        <span class="detail-label">
                            <i class="bi bi-people"></i> Employés affectés
                        </span>
                        <span class="detail-value">
                            @if (Model.NombreEmployes > 0)
                            {
                                <span class="badge bg-danger">@Model.NombreEmployes employé(s)</span>
                            }
                            else
                            {
                                <span class="text-success">Aucun</span>
                            }
                        </span>
                    </div>
                </div>

                @if (Model.NombreEmployes > 0)
                {
                    <div class="alert-warning-custom">
                        <div class="d-flex align-items-center">
                            <i class="bi bi-x-circle-fill text-danger fs-4 me-2"></i>
                            <div>
                                <strong class="text-danger">Suppression impossible</strong>
                                <p class="mb-0 small">
                                    Ce poste contient actuellement <strong>@Model.NombreEmployes employé(s)</strong>.
                                    Vous ne pourrez pas le supprimer tant qu'ils n'auront pas été réaffectés à d'autres postes.
                                </p>
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <div class="alert alert-info">
                        <div class="d-flex align-items-center">
                            <i class="bi bi-info-circle-fill text-primary fs-4 me-2"></i>
                            <div>
                                <strong>Conseil de sécurité</strong>
                                <p class="mb-0 small">
                                    Assurez-vous qu'aucun employé n'est affecté à ce poste avant de procéder à la suppression.
                                    Cette action ne peut pas être annulée.
                                </p>
                            </div>
                        </div>
                    </div>
                }

                <form asp-action="Delete" id="deleteForm">
                    <input type="hidden" asp-for="Id" />
                    
                    <div class="d-flex justify-content-between align-items-center pt-4 border-top">
                        <a asp-action="Index" class="btn btn-outline-secondary-custom">
                            <i class="bi bi-arrow-left"></i> Annuler
                        </a>
                        
                        <button type="submit" class="btn btn-danger-custom" 
                                id="confirmDeleteBtn" 
                                @(Model.NombreEmployes > 0 ? "disabled" : "")>
                            <i class="bi bi-trash"></i> Confirmer la suppression
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            let deleteConfirmed = false;
            
            $('#confirmDeleteBtn').on('click', function(e) {
                if (!$(this).prop('disabled')) {
                    if (!deleteConfirmed) {
                        e.preventDefault();
                        
                        // Première confirmation
                        if (confirm('⚠️ Êtes-vous ABSOLUMENT sûr de vouloir supprimer ce poste ?')) {
                            // Seconde confirmation
                            if (confirm('❌ Cette action est IRREVERSIBLE. Toutes les données du poste seront définitivement perdues.\n\nConfirmez-vous la suppression définitive ?')) {
                                deleteConfirmed = true;
                                $(this).click();
                            }
                        }
                    }
                }
            });
        });
    </script>
}